# ========================================
# Alpaca Options Lab - Environment Config
# ========================================

# Alpaca Trading API (Required)
# Get your keys at: https://alpaca.markets
APCA_API_KEY_ID=your_alpaca_key_here
APCA_API_SECRET_KEY=your_alpaca_secret_here

# Alternative Alpaca Keys (Optional - for multiple accounts)
ALPACA2_KEY=
ALPACA2_SECRET=
ALPACA3_KEY=
ALPACA3_SECRET=

# Market Data APIs (Optional - enhances data quality)
# Finnhub: https://finnhub.io
FINNHUB_API_KEY=

# Tiingo: https://tiingo.com
TIINGO_API_KEY=

# NewsAPI: https://newsapi.org
NEWSAPI_KEY=

# StockTwits: https://api.stocktwits.com
STOCKTWITS_API_KEY=

# AI/LLM APIs (Optional)
GROQ_API_KEY=

# Database (Optional - for persistent storage)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=options_lab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Redis (Optional - for caching)
REDIS_HOST=localhost
REDIS_PORT=6379

# Application Settings
PORT=8053
HOST=0.0.0.0
DEBUG=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/system.log
