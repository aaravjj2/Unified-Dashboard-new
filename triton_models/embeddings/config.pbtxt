name: "embeddings"
platform: "pytorch_libtorch"
max_batch_size: 128
input {
  name: "input_ids"
  data_type: TYPE_INT64
  dims: [ 256 ]
}
input {
  name: "attention_mask"
  data_type: TYPE_INT64
  dims: [ 256 ]
}
output {
  name: "last_hidden_state"
  data_type: TYPE_FP32
  dims: [ 256, 384 ]
}
instance_group {
  kind: KIND_GPU
  count: 1
}