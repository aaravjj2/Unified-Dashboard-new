name: "sentiment_finbert"
platform: "pytorch_libtorch"
max_batch_size: 64
input {
  name: "input_ids"
  data_type: TYPE_INT64
  dims: [ 512 ]
}
input {
  name: "attention_mask"
  data_type: TYPE_INT64
  dims: [ 512 ]
}
output {
  name: "logits"
  data_type: TYPE_FP32
  dims: [ 3 ]
}
instance_group {
  kind: KIND_GPU
  count: 1
}
dynamic_batching {
  max_queue_delay_microseconds: 50000
}