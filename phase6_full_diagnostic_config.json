{
  "test_metadata": {
    "suite_name": "Phase 6 Full Diagnostic & Validation Suite",
    "version": "1.0.0",
    "description": "Comprehensive cross-phase validation for Unified Financial Dashboard (Phases 0-5) with reproducibility, performance, contract, and UI validation",
    "author": "Agent 1B - Lead Engineer",
    "date_created": "2025-10-29",
    "scope": "All phases (0-5): Layout, Explainability, Visualizations, Analytics, Hybrid Bridge, E2E Testing"
  },
  
  "test_execution": {
    "iterations": 3,
    "delay_between_iterations_seconds": 5,
    "retry_on_failure": true,
    "max_retries_per_test": 2,
    "continue_on_failure": true,
    "capture_screenshots": true,
    "generate_visual_diff": false,
    "parallel_execution": false,
    "accessibility_validation": true,
    "contract_validation": true,
    "cache_validation": true,
    "reproducibility_validation": true
  },
  
  "dashboard_config": {
    "host": "127.0.0.1",
    "port": 8050,
    "base_url": "http://127.0.0.1:8050",
    "startup_timeout_seconds": 30,
    "page_load_timeout_seconds": 10,
    "debug_mode": false,
    "headless_browser": true,
    "viewport_width": 1920,
    "viewport_height": 1080
  },
  
  "azure_mock_config": {
    "AZURE_ML_OFFLINE_MODE": true,
    "AZURE_SUBSCRIPTION_ID": "mock-subscription-id",
    "AZURE_RESOURCE_GROUP": "mock-resource-group",
    "AZURE_ML_WORKSPACE": "unified-dashboard-ml-mock",
    "AZURE_STORAGE_CONNECTION_STRING": "mock-connection-string"
  },
  
  "phase_coverage": {
    "phase_0": {
      "enabled": true,
      "description": "Dashboard layout, weekly/monthly picks tables, market trends table",
      "features": [
        "Dashboard boot and layout rendering",
        "Weekly picks table with black text",
        "Monthly picks table with black text",
        "Market trends table visibility",
        "Tab navigation (Trends, Forecast, Monthly Picks, Weekly Picks, Analysis Hub)",
        "Tooltips and accessibility"
      ]
    },
    "phase_1": {
      "enabled": true,
      "description": "Local Explainability Engine, Model Insight Explorer, mock SHAP outputs",
      "features": [
        "SHAP data loading and generation",
        "Explainability Engine mock outputs",
        "Model Insight Explorer UI",
        "Feature importance visualization",
        "SHAP summary plots",
        "Deterministic SHAP generation"
      ]
    },
    "phase_2": {
      "enabled": true,
      "description": "Offline visualization & chart enhancements (Phase 2.5/2.6 included)",
      "features": [
        "Chart rendering performance",
        "Visualization enhancements",
        "Color schemes and accessibility",
        "Tooltip functionality",
        "Interactive charts",
        "Chart export capabilities"
      ]
    },
    "phase_3": {
      "enabled": true,
      "description": "Offline Portfolio Analytics, risk metrics, sector analysis, benchmark comparison",
      "features": [
        "Portfolio snapshot",
        "Risk metrics (Sharpe, Sortino, Max Drawdown, VaR, CVaR)",
        "Sector allocation analysis",
        "Benchmark comparison (SPY)",
        "Portfolio performance metrics",
        "Offline analytics computation"
      ]
    },
    "phase_3_5": {
      "enabled": true,
      "description": "Hybrid bridge, data contracts, 3-tier cache, integrity validation",
      "features": [
        "Data contracts (input/output specs)",
        "3-tier caching (L1/L2/L3)",
        "Cache hit rate ≥70%",
        "Contract validation",
        "Schema versioning (v0.1)",
        "Integrity validation"
      ]
    },
    "phase_4": {
      "enabled": true,
      "description": "Hybrid stubs for Azure ML, offline functional verification",
      "features": [
        "Azure ML stub clients",
        "Offline mode operation",
        "Contract-driven architecture",
        "Mock Azure ML responses",
        "Hybrid interface",
        "Telemetry logging"
      ]
    },
    "phase_5": {
      "enabled": true,
      "description": "E2E reproducibility loop (mock mode)",
      "features": [
        "3-iteration reproducibility",
        "Max 5% variation tolerance",
        "E2E test suite execution",
        "Screenshot capture",
        "Report generation",
        "Mock mode validation"
      ]
    }
  },
  
  "tabs_to_test": [
    {
      "tab_id": "tab-trends",
      "tab_name": "Market Trends",
      "phase": 0,
      "expected_elements": ["trends-table", "run-btn-unified"],
      "test_interactions": ["run-btn-unified"],
      "screenshot_name": "phase0_market_trends.png",
      "ui_validation": {
        "text_color": "#000000",
        "table_visibility": true,
        "tooltip_check": false
      }
    },
    {
      "tab_id": "tab-forecast",
      "tab_name": "Market Forecast",
      "phase": 0,
      "expected_elements": ["forecast-content", "mf-run"],
      "test_interactions": [],
      "screenshot_name": "phase0_market_forecast.png",
      "ui_validation": {
        "text_color": "#000000",
        "table_visibility": true,
        "tooltip_check": false
      }
    },
    {
      "tab_id": "tab-monthly-picks",
      "tab_name": "Monthly Picks",
      "phase": 0,
      "expected_elements": ["monthly-picks-table"],
      "test_interactions": [],
      "screenshot_name": "phase0_monthly_picks.png",
      "ui_validation": {
        "text_color": "#000000",
        "table_visibility": true,
        "tooltip_check": false
      }
    },
    {
      "tab_id": "tab-weekly-picks",
      "tab_name": "Weekly Picks",
      "phase": 0,
      "expected_elements": ["weekly-picks-table"],
      "test_interactions": [],
      "screenshot_name": "phase0_weekly_picks.png",
      "ui_validation": {
        "text_color": "#000000",
        "table_visibility": true,
        "tooltip_check": false
      }
    },
    {
      "tab_id": "tab-analysis",
      "tab_name": "Analysis Hub",
      "phase": 0,
      "expected_elements": ["analysis-content"],
      "test_interactions": [],
      "screenshot_name": "phase0_analysis_hub.png",
      "ui_validation": {
        "text_color": "#000000",
        "table_visibility": false,
        "tooltip_check": false
      }
    }
  ],
  
  "ui_validation": {
    "enforce_black_text": true,
    "expected_text_color": "#000000",
    "wcag_contrast_ratio_min": 4.5,
    "wcag_level": "AA",
    "check_tooltips": true,
    "check_table_visibility": true,
    "check_chart_rendering": true,
    "check_layout_consistency": true,
    "screenshot_all_tabs": true
  },
  
  "data_contract_validation": {
    "enabled": true,
    "contract_version": "v0.1",
    "validate_schemas": true,
    "validate_hashes": true,
    "contracts_to_validate": [
      {
        "contract_name": "portfolio_snapshot",
        "input_schema": "portfolio_snapshot_input_v0.1",
        "output_schema": "portfolio_snapshot_output_v0.1",
        "phase": "3.5"
      },
      {
        "contract_name": "market_forecast",
        "input_schema": "market_forecast_input_v0.1",
        "output_schema": "market_forecast_output_v0.1",
        "phase": "4"
      },
      {
        "contract_name": "options_forecast",
        "input_schema": "options_forecast_input_v0.1",
        "output_schema": "options_forecast_output_v0.1",
        "phase": "4"
      },
      {
        "contract_name": "explainability_shap",
        "input_schema": "explainability_input_v0.1",
        "output_schema": "explainability_output_v0.1",
        "phase": "1"
      }
    ]
  },
  
  "analytics_validation": {
    "portfolio_analytics": {
      "enabled": true,
      "phase": 3,
      "metrics_to_validate": [
        "sharpe_ratio",
        "sortino_ratio",
        "max_drawdown",
        "var_95",
        "cvar_95",
        "total_return",
        "annualized_return",
        "volatility"
      ],
      "tolerance_percent": 5.0
    },
    "forecast_analytics": {
      "enabled": true,
      "phase": 4,
      "forecast_types": ["market", "options"],
      "min_predictions": 20,
      "max_latency_ms": 2000
    },
    "explainability_analytics": {
      "enabled": true,
      "phase": 1,
      "shap_validation": true,
      "min_features": 5,
      "max_latency_ms": 2500,
      "deterministic_check": true
    }
  },
  
  "performance_metrics": {
    "tab_rendering": {
      "target_ms": 2000,
      "tolerance_ms": 500
    },
    "chart_rendering": {
      "target_ms": 1500,
      "tolerance_ms": 300
    },
    "portfolio_refresh": {
      "target_ms": 1000,
      "tolerance_ms": 200
    },
    "forecast_generation": {
      "target_ms": 2000,
      "tolerance_ms": 500
    },
    "explainability_generation": {
      "target_ms": 2500,
      "tolerance_ms": 500
    },
    "cache_access": {
      "l1_target_ms": 5,
      "l2_target_ms": 50,
      "l3_target_ms": 100
    }
  },
  
  "cache_validation": {
    "enabled": true,
    "phase": "3.5",
    "cache_tiers": ["L1", "L2", "L3"],
    "min_hit_rate_percent": 70,
    "test_cache_warmup": true,
    "test_cache_invalidation": true,
    "validate_lru_policy": true,
    "cache_locations": {
      "L1": "memory",
      "L2": "disk (data/hybrid_cache/)",
      "L3": "hybrid_cloud_stub"
    }
  },
  
  "reproducibility_validation": {
    "enabled": true,
    "iterations": 3,
    "max_variation_percent": 5.0,
    "metrics_to_compare": [
      "portfolio_sharpe_ratio",
      "portfolio_total_return",
      "forecast_prediction_count",
      "explainability_feature_count",
      "cache_hit_rate",
      "tab_rendering_time",
      "contract_validation_success"
    ],
    "comparison_method": "percentage_difference",
    "fail_on_high_variation": false
  },
  
  "backend_tests": {
    "portfolio_snapshot": {
      "enabled": true,
      "test_data_availability": true,
      "test_calculations": true,
      "test_cache": true
    },
    "portfolio_analytics": {
      "enabled": true,
      "test_risk_metrics": true,
      "test_sector_analysis": true,
      "test_benchmark_comparison": true
    },
    "market_forecast": {
      "enabled": true,
      "test_mock_predictions": true,
      "test_contract_compliance": true,
      "test_latency": true
    },
    "options_forecast": {
      "enabled": true,
      "test_mock_recommendations": true,
      "test_contract_compliance": true
    },
    "explainability_engine": {
      "enabled": true,
      "test_shap_generation": true,
      "test_deterministic_output": true,
      "test_feature_importance": true
    },
    "cache_router": {
      "enabled": true,
      "test_hit_rate": true,
      "test_lru_eviction": true,
      "test_tier_fallback": true
    },
    "hybrid_bridge": {
      "enabled": true,
      "test_offline_mode": true,
      "test_contract_validation": true,
      "test_schema_validation": true
    }
  },
  
  "output_config": {
    "base_directory": "outputs/phase6_full",
    "subdirectories": {
      "screenshots": "screenshots",
      "reports": "reports",
      "logs": "logs",
      "cache_stats": "cache_stats"
    },
    "report_formats": ["json", "markdown", "csv"],
    "screenshot_format": "png",
    "log_level": "INFO",
    "create_directories": true
  },
  
  "test_data": {
    "mock_portfolio_tickers": ["AAPL", "MSFT", "GOOGL", "AMZN", "NVDA"],
    "mock_forecast_date": "20251029",
    "mock_shap_date": "20251029",
    "mock_picks_csv": "models/picks_20251029.csv",
    "azure_stub_storage": "data/azure_stub_storage"
  },
  
  "alerts": {
    "notify_on_failure": true,
    "notify_on_performance_degradation": true,
    "notify_on_high_variation": true,
    "notify_on_contract_violation": true,
    "failure_threshold": 10,
    "performance_degradation_threshold_percent": 20,
    "variation_threshold_percent": 5
  }
}
