    {
      "tab_id": "weekly-picks",
      "tab_name": "Weekly Picks",
      "expected_elements": ["weekly-picks-table"],
      "test_interactions": [],
      "screenshot_name": "weekly_picks.png"
    },
    {
      "tab_id": "monthly-picks",
      "tab_name": "Monthly Picks",
      "expected_elements": ["monthly-picks-table"],
      "test_interactions": [],
      "screenshot_name": "monthly_picks.png"
