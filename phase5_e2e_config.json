      "screenshot_name": "strategy_lab.png",
      "subtabs": [
        {
          "subtab_id": "backtest",
          "subtab_name": "Backtest",
          "expected_elements": ["backtest-chart", "backtest-metrics"],
          "screenshot_name": "strategy_lab_backtest.png"
        },
        {
          "subtab_id": "optimization",
          "subtab_name": "Optimization",
          "expected_elements": ["optimization-results"],
          "screenshot_name": "strategy_lab_optimization.png"
