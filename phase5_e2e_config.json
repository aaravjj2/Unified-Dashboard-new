  "performance_targets": {
    "tab_load_latency_ms": 2000,
    "chart_render_latency_ms": 1500,
    "portfolio_refresh_latency_ms": 1000,
    "explainability_generation_ms": 2500,
    "forecast_generation_ms": 2000,
    "cache_hit_rate_percent": 50,
    "schema_validation_success_rate_percent": 100
  },
  
  "contract_validation": {
    "validate_input_contracts": true,
    "validate_output_contracts": true,
    "validate_schema_versions": true,
    "allowed_schema_versions": ["0.1"],
    "strict_validation": true,
    "log_validation_errors": true
  },
  
  "backend_tests": {
    "test_portfolio_analytics": true,
    "test_forecast_engine": true,
    "test_explainability_engine": true,
    "test_cache_router": true,
    "test_hybrid_bridge": true,
    "test_azure_stubs": true
  },
  
  "visual_validation": {
    "check_text_color": true,
    "expected_text_color": "#000000",
    "check_table_visibility": true,
    "check_chart_rendering": true,
    "min_chart_height_px": 200,
    "min_table_rows": 1
  },
  
  "output_config": {
    "output_directory": "./outputs/phase5_e2e",
    "screenshots_directory": "./outputs/phase5_e2e/screenshots",
    "reports_directory": "./outputs/phase5_e2e/reports",
    "logs_directory": "./outputs/phase5_e2e/logs",
    "save_json_report": true,
    "save_markdown_report": true,
    "save_csv_metrics": true,
    "save_html_summary": false
  },
  
  "reproducibility_validation": {
    "enabled": true,
    "max_variation_percent": 5,
    "compare_iterations": true,
    "flag_discrepancies": true,
    "hash_data_contracts": true,
    "verify_cache_consistency": true
  },
  
  "test_data": {
    "mock_tickers": ["AAPL", "MSFT", "GOOGL", "AMZN", "META"],
    "mock_features": {
      "momentum_20d": 0.05,
      "volatility_20d": 0.15,
      "sharpe_20d": 1.5,
      "pe_ratio": 25.0,
      "market_cap": 2.5e12
    },
    "mock_date_range": ["2025-01-01", "2025-12-31"],
    "mock_forecast_horizon": "monthly"
  },
  
  "alerts": {
    "alert_on_failure": true,
    "alert_on_slow_performance": true,
    "alert_on_reproducibility_issue": true,
    "performance_threshold_multiplier": 1.5
  }
}
