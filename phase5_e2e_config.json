          "screenshot_name": "strategy_lab_custom.png"
        },
        {
          "subtab_id": "performance-comparison",
          "subtab_name": "Performance Comparison",
          "expected_elements": ["comparison-chart"],
          "screenshot_name": "strategy_lab_comparison.png"
        }
      ]
