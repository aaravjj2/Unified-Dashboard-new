{
  "test_metadata": {
    "suite_name": "Phase 5 E2E Testing Loop",
    "version": "1.0.0",
    "description": "Comprehensive end-to-end testing suite for Unified Financial Dashboard with reproducibility validation",
    "author": "Agent 1B - Lead Engineer",
    "date_created": "2025-10-29"
  },
  
  "test_execution": {
    "iterations": 3,
    "delay_between_iterations_seconds": 5,
    "retry_on_failure": true,
    "max_retries_per_test": 2,
    "continue_on_failure": true,
    "capture_screenshots": true,
    "generate_visual_diff": false,
    "parallel_execution": false
  },
  
  "dashboard_config": {
    "host": "127.0.0.1",
    "port": 8050,
    "base_url": "http://127.0.0.1:8050",
    "startup_timeout_seconds": 30,
    "page_load_timeout_seconds": 10,
    "debug_mode": false,
    "headless_browser": true
  },
  
  "azure_mock_config": {
    "AZURE_ML_OFFLINE_MODE": true,
    "AZURE_SUBSCRIPTION_ID": "mock-subscription-id",
    "AZURE_RESOURCE_GROUP": "mock-resource-group",
    "AZURE_ML_WORKSPACE": "unified-dashboard-ml-mock",
    "AZURE_STORAGE_CONNECTION_STRING": "mock-connection-string"
  },
  
  "tabs_to_test": [
    {
      "tab_id": "portfolio-snapshot",
      "tab_name": "Portfolio Snapshot",
      "expected_elements": ["portfolio-table", "portfolio-metrics", "portfolio-chart"],
      "test_interactions": ["refresh-button"],
      "screenshot_name": "portfolio_snapshot.png"
    },
    {
      "tab_id": "portfolio-allocation",
      "tab_name": "Portfolio Allocation",
      "expected_elements": ["allocation-pie-chart", "allocation-table"],
