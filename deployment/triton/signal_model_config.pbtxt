name: "signal_model"
platform: "onnxruntime_onnx"
max_batch_size: 64

input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [50]
  }
]

output [
  {
    name: "output"
    data_type: TYPE_FP32
    dims: [1]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_CPU
  }
]

dynamic_batching {
  preferred_batch_size: [1, 8, 16, 32]
  max_queue_delay_microseconds: 100
}

# Optimization settings for low latency
optimization {
  input_pinned_memory { enable: true }
  output_pinned_memory { enable: true }
}
