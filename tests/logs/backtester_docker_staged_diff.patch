+            num_val = float(value)
+            return {
+                "display": f"${num_val:,.2f}",
+                "value": f"{num_val:.2f}",
+                "label": f"${num_val:,.2f}"
+            }
+        elif is_percent:
+            num_val = float(value)
+            return {
+                "display": f"{num_val:+.2f}%",
+                "value": f"{num_val:.2f}",
+                "label": f"{num_val:+.2f}%"
+            }
+        else:
+            return {
+                "display": str(value),
+                "value": str(value),
+                "label": str(value)
+            }
+    except (ValueError, TypeError):
+        return {
+            "display": "Data Unavailable",
+            "value": "",
+            "label": "Data Unavailable"
