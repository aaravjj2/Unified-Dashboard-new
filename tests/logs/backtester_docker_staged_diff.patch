+"""
+Backtester Service for running strategy backtests at scale.
+
+This service provides:
+- Core backtesting logic with metrics computation
+- REST API for backtest execution
+- CLI for ad-hoc backtests
+- MLflow integration for experiment tracking
+"""
+
+__version__ = "0.1.0"
