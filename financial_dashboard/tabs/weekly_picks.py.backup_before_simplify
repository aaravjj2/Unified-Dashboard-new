def register_callbacks(app, SH=None):
    if SH is None:
        import _shared as SH

    def _demo_target(max_tickers, debug=False):
        # Demo target: load latest picks CSV; optionally print debug info
        if debug:
            print(f"DEBUG: running weekly demo target for max_tickers={max_tickers}")
            print("DEBUG: note - running full news fetch for all tickers may be slow and will make external API calls")
        df, p = _load_weekly_df()
        if df is None:
            print('DEBUG: failed to load weekly df:', p) if debug else None
            return {'ok': False, 'error': p}
        # optionally show a small sample when debug is enabled
        if debug:
            try:
                print('DEBUG: sample tickers:', list(df['ticker'].head(10)))
            except Exception:
                pass
        return df

    @app.callback(Output('wp-current-job', 'data'), Input('wp-run-btn', 'n_clicks'), State('wp-max-tickers', 'value'), State('wp-debug-logs', 'value'), prevent_initial_call=True)
    def _run(n_clicks, max_tickers, debug_val):
        if not n_clicks:
            raise PreventUpdate
        debug = bool(debug_val and 'debug' in debug_val)
        if SH is not None and hasattr(SH, 'start_background_job'):
            # attempt to pass debug flag to shared runner
            try:
                jid = SH.start_background_job(_demo_target, args=(max_tickers, debug), job_name='weekly_picks')
            except Exception:
                jid = SH.start_background_job(_demo_target, args=(max_tickers,), job_name='weekly_picks')
        else:
            jid = _start_local_job(_demo_target, args=(max_tickers, debug), name='weekly_picks')
        return jid

    # The standalone table should refresh when a job completes.
    # REMOVED prevent_initial_call=True so it loads data on initial render
    @app.callback(Output('wp-standalone-table', 'children'), Input('wp-current-job', 'data'))
    def _render(job):
        # This callback triggers when a job completes OR on initial load (when job is '')
        # Load and display the most recent weekly picks
        df, p = _load_weekly_df()
        if df is None:
            return [html.Div([html.H4('No weekly picks available'), html.P(p)])]
        
        try:
            df = _fetch_live_prices_for_week_df(df, SH=SH)
        except Exception:
            pass

        disp = _prepare_weekly_display_df(df)
        try:
            disp = _attempt_enriched_backfill(disp)
        except Exception:
            pass
        
        try:
            d = disp.copy()
            records = d.fillna('').to_dict(orient='records')
            cols = []
            # Friendly header names to match Flask HTML viewers
            display_name_map = {
                'Rank': 'Rank',
                'ticker': 'Ticker',
                'price_live': 'Current Price',
                'daily_change': 'Daily Change %',
                'week_start': 'Week Start Price',
                'profit_loss': 'Profit/Loss',
                'date': 'Date'
            }
            for c in d.columns:
                col = {'name': display_name_map.get(c, c), 'id': c}
                if c in ('price_live', 'week_start', 'profit_loss'):
                    col.update({'type': 'numeric', 'format': {'specifier': ',.2f'}})
                elif c in ('daily_change', 'overall_change'):
                    col.update({'type': 'numeric', 'format': {'specifier': '.4f'}})
                cols.append(col)

            style_data_conditional = [
                {'if': {'column_id': 'price_live'}, 'textAlign': 'right'},
                {'if': {'column_id': 'profit_loss'}, 'textAlign': 'right'},
                {'if': {'column_id': 'daily_change'}, 'textAlign': 'right'},
                {'if': {'column_id': 'overall_change'}, 'textAlign': 'right'},
                {'if': {'filter_query': '{profit_loss} > 0', 'column_id': 'profit_loss'}, 'color': '#10B981'},
                {'if': {'filter_query': '{profit_loss} < 0', 'column_id': 'profit_loss'}, 'color': '#EF4444'},
                {'if': {'filter_query': '{daily_change} > 0', 'column_id': 'daily_change'}, 'color': '#10B981'},
                {'if': {'filter_query': '{daily_change} < 0', 'column_id': 'daily_change'}, 'color': '#EF4444'},
                {'if': {'filter_query': '{overall_change} > 0', 'column_id': 'overall_change'}, 'color': '#10B981'},
                {'if': {'filter_query': '{overall_change} < 0', 'column_id': 'overall_change'}, 'color': '#EF4444'},
            ]
            if 'overall_change' in d.columns and 'price_live' in d.columns:
                style_data_conditional.extend([
                    {'if': {'filter_query': '{overall_change} > 0', 'column_id': 'price_live'}, 'color': '#10B981', 'fontWeight': '700'},
                    {'if': {'filter_query': '{overall_change} < 0', 'column_id': 'price_live'}, 'color': '#EF4444', 'fontWeight': '700'}
                ])

            table = dash_table.DataTable(
                columns=cols,
                data=records,
                page_size=25,
                style_table={'overflowX': 'auto', 'width': '100%'},
                style_cell={'whiteSpace': 'nowrap', 'height': '28px', 'textAlign': 'left', 'fontSize': '11px', 'padding': '4px 6px', 'color': '#000'},
                style_data_conditional=style_data_conditional,
                style_header={'fontSize': '11px', 'fontWeight': '600'},
                style_as_list_view=True,
            )
        except Exception:
            table = html.Div('Failed to build table')
        
        metrics = _render_metrics(disp)

        prov_children = []
        attrs = getattr(disp, 'attrs', {})
        if attrs.get('picks_path'):
            prov_children.append(html.Div(f"Showing: {os.path.basename(attrs['picks_path'])}", style={'fontSize': '12px', 'color': '#cbd5e1'}))
        if attrs.get('provenance'):
            md = attrs['provenance']
            prov_children.append(html.Div(f"model: {md.get('model_dir','')}", style={'fontSize': '12px', 'color': '#cbd5e1', 'marginLeft': '12px'}))
            prov_children.append(html.Div(f"stacker: {md.get('stacker','')}", style={'fontSize': '12px', 'color': '#cbd5e1', 'marginLeft': '12px'}))
            if md.get('generated_utc'):
                prov_children.append(html.Div(f"generated: {md.get('generated_utc')}", style={'fontSize': '12px', 'color': '#cbd5e1', 'marginLeft': '12px'}))
        if attrs.get('week_start_source'):
            wk_src = attrs['week_start_source']
            human = 'derived from enrichment' if wk_src == 'derived_from_enrichment' else ('from picks CSV' if wk_src == 'from_picks' else 'none')
            prov_children.append(html.Div(f"week_start: {human}", style={'fontSize': '12px', 'color': '#cbd5e1', 'marginLeft': '12px'}))

        prov = html.Div(prov_children, style={'display': 'flex', 'gap': '8px', 'marginTop': '8px'}) if prov_children else html.Div()

        # return as a single-element list to be compatible with wildcard/multi-output
        return [html.Div([prov, table, metrics])]

    # update download link href when picks path changes or on refresh/run
    @app.callback(Output('wp-download-link', 'href'), Input('wp-current-job', 'data'))
    def _update_download(job):
        p = _find_latest_weekly_picks()
        if not p:
            return ''
        # translate abs path to a relative path for server static hosting if needed
        try:
            # if Dash is serving static files from project root, a relative path is fine
            rel = os.path.relpath(p, SH.PROJECT_ROOT)
            return '/' + rel.replace('\\', '/')
        except Exception:
            return p

    @app.callback(Output('wp-status', 'children'), Output('wp-debug-log', 'style'), Output('wp-debug-log', 'children'), Input('wp-current-job', 'data'))
    def _show_job_status(job):
        # Return a short status and show/hide debug log content if available
        if not job:
            return ('', {'display': 'none'}, '')
        st = JOBS.get(job, {})
        name = st.get('name', '')
        status = st.get('status', '')
        msg = html.Div(f"Job {name} ({job}) status: {status}")
        log_style = {'display': 'none'}
        log_text = ''
        if st and st.get('log'):
            log_style = {'display': 'block', 'whiteSpace': 'pre-wrap', 'maxHeight': '300px', 'overflow': 'auto', 'backgroundColor': '#000', 'color': '#fff', 'padding': '8px'}
            log_text = st.get('log')
        return (msg, log_style, log_text)

    # Ensure outputs_spec entries exist for callbacks we just registered.
    try:
        _registered = [_run, _render, _update_download]
        for func in _registered:
            try:
                for k, v in app.callback_map.items():
                    try:
                        if isinstance(v, dict) and v.get('callback') is func and v.get('outputs_spec') is None:
                            oi = v.get('outputs_indices')
                            if isinstance(oi, list):
                                count = len(oi)
                            elif isinstance(oi, int):
                                count = 1
                            else:
                                out = v.get('output')
                                try:
                                    count = len(out) if isinstance(out, (list, tuple)) else 1
                                except Exception:
                                    count = 1
                            # Use an empty dict placeholder ({}), not None, so
                            # Dash treats the outputs_spec as present and counts
                            # returned values correctly.
                            v['outputs_spec'] = [{}] * count
                    except Exception:
                        pass
            except Exception:
                pass
    except Exception:
        pass