def register_callbacks(app):
    """Register all callbacks for the Options Lab tab."""
    
    # Callback 1: Strategy Monitor - Refresh Data
    @app.callback(
        [Output('opt-strategy-status', 'children'),
         Output('opt-strategy-status', 'className'),
         Output('opt-last-run', 'children'),
         Output('opt-position-count', 'children'),
         Output('opt-total-pnl', 'children'),
         Output('opt-positions-table', 'data'),
         Output('opt-log-list', 'children')],
        [Input('opt-refresh-btn', 'n_clicks'),
         Input('opt-monitor-interval', 'n_intervals')]
    )
    def refresh_strategy_monitor(n_clicks, n_intervals):
        """Refresh strategy monitoring data from options service."""
        try:
            # Fetch strategy status
            status_response = requests.get(f'{OPTIONS_SERVICE_URL}/strategy/status', timeout=5)
            status_data = status_response.json() if status_response.status_code == 200 else {}
            
            # Fetch positions
            positions_response = requests.get(f'{OPTIONS_SERVICE_URL}/positions', timeout=5)
            positions_data = positions_response.json() if positions_response.status_code == 200 else {}
            
            # Fetch recent alerts
            alerts_response = requests.get(f'{OPTIONS_SERVICE_URL}/alerts/recent?limit=10', timeout=5)
            alerts_data = alerts_response.json() if alerts_response.status_code == 200 else {}
            
            # Parse status
            status = status_data.get('status', 'Unknown')
            status_class = 'text-success' if status == 'Running' else 'text-warning'
            last_run = status_data.get('last_run', 'Never')
            
            # Parse positions
            positions = positions_data.get('positions', [])
            position_count = len(positions)
            total_pnl = sum([float(p.get('unrealized_pl', 0)) for p in positions])
            
            # Format positions table
            positions_table = []
            for pos in positions:
                positions_table.append({
                    'symbol': pos.get('symbol', ''),
                    'option_type': pos.get('option_type', ''),
                    'strike': f"${pos.get('strike', 0)}",
                    'expiration': pos.get('expiration', ''),
                    'quantity': pos.get('qty', 0),
                    'entry_price': f"${pos.get('avg_entry_price', 0):.2f}",
                    'current_price': f"${pos.get('current_price', 0):.2f}",
                    'pnl': f"${pos.get('unrealized_pl', 0):.2f}",
                    'pnl_pct': f"{pos.get('unrealized_plpc', 0)*100:.2f}%"
                })
            
            # Format alerts
            alerts = alerts_data.get('alerts', [])
            log_items = []
            for alert in alerts:
                color_map = {'INFO': 'info', 'WARNING': 'warning', 'ERROR': 'danger', 'SUCCESS': 'success'}
                color = color_map.get(alert.get('severity', 'INFO'), 'light')
                timestamp = alert.get('timestamp', '')
                message = alert.get('message', '')
                log_items.append(
                    dbc.ListGroupItem(f"[{timestamp}] {message}", color=color)
                )
            
            if not log_items:
                log_items = [dbc.ListGroupItem("No recent activity", color="light")]
            
            return (
                status, status_class, f"Last Run: {last_run}",
                str(position_count), f"${total_pnl:.2f}",
                positions_table, log_items
            )
            
        except Exception as e:
            logger.error(f"Error refreshing strategy monitor: {e}")
            return (
                "Error", "text-danger", "Last Run: Error",
                "0", "$0.00", [],
                [dbc.ListGroupItem(f"Error: {str(e)}", color="danger")]
            )
    
    # Callback 2: Strategy Control Buttons
    @app.callback(
        Output('opt-status-message', 'children'),
        [Input('opt-start-btn', 'n_clicks'),
         Input('opt-pause-btn', 'n_clicks'),
         Input('opt-stop-btn', 'n_clicks')],
        prevent_initial_call=True
    )
    def control_strategy(start_clicks, pause_clicks, stop_clicks):
        """Handle strategy start/pause/stop actions."""
        ctx = callback_context
        if not ctx.triggered:
            raise PreventUpdate
        
        button_id = ctx.triggered[0]['prop_id'].split('.')[0]
        
        try:
            if button_id == 'opt-start-btn':
                response = requests.post(f'{OPTIONS_SERVICE_URL}/strategy/start', timeout=5)
                message = response.json().get('message', 'Strategy started')
                return dbc.Alert(message, color='success', dismissable=True)
            
            elif button_id == 'opt-pause-btn':
                response = requests.post(f'{OPTIONS_SERVICE_URL}/strategy/pause', timeout=5)
                message = response.json().get('message', 'Strategy paused')
                return dbc.Alert(message, color='warning', dismissable=True)
            
            elif button_id == 'opt-stop-btn':
                response = requests.post(f'{OPTIONS_SERVICE_URL}/strategy/stop', timeout=5)
                message = response.json().get('message', 'Strategy stopped')
                return dbc.Alert(message, color='info', dismissable=True)
        
        except Exception as e:
            logger.error(f"Error controlling strategy: {e}")
            return dbc.Alert(f"Error: {str(e)}", color='danger', dismissable=True)
    
    # Callback 3: Load Expirations for Ticker
    @app.callback(
        [Output('opt-expiration-dropdown', 'options'),
         Output('opt-stock-price', 'children')],
        [Input('opt-ticker-input', 'value')]
    )
    def load_expirations(ticker):
        """Load available expiration dates for the selected ticker."""
        if not ticker:
            return [], "--"
        
        try:
            # Get stock quote
            quote_response = requests.get(
                f'{OPTIONS_SERVICE_URL}/quote/{ticker}', timeout=5
            )
            quote_data = quote_response.json() if quote_response.status_code == 200 else {}
            stock_price = quote_data.get('c', 0)  # Current price
            
            # Get expirations
            exp_response = requests.get(
                f'{OPTIONS_SERVICE_URL}/expirations/{ticker}', timeout=5
            )
            exp_data = exp_response.json() if exp_response.status_code == 200 else {}
            expirations = exp_data.get('expirations', [])
            
            exp_options = [{'label': exp, 'value': exp} for exp in expirations]
            
            return exp_options, f"${stock_price:.2f}"
        
        except Exception as e:
            logger.error(f"Error loading expirations: {e}")
            return [], "--"
    
    # Callback 4: Load Options Chain
    @app.callback(
        [Output('opt-chain-table', 'data'),
         Output('opt-chain-status', 'children')],
        [Input('opt-get-chain-btn', 'n_clicks')],
        [State('opt-ticker-input', 'value'),
         State('opt-expiration-dropdown', 'value'),
         State('opt-expiration-calendar', 'date')]
    )
    def load_options_chain(n_clicks, ticker, expiration_dropdown, expiration_calendar):
        """Load and display options chain for selected ticker and expiration."""
        if not n_clicks or not ticker:
            raise PreventUpdate
        
        # Ensure ticker is uppercase
        ticker = ticker.strip().upper()
        
        # Use calendar date if provided, otherwise use dropdown
        expiration = expiration_calendar if expiration_calendar else expiration_dropdown
        
        if not expiration:
            return [], dbc.Alert("Please select an expiration date", color='warning')
        
        try:
            response = requests.get(
                f'{OPTIONS_SERVICE_URL}/options-chain/{ticker}',
                params={'expiration': expiration},
                timeout=10
            )
            
            if response.status_code != 200:
                return [], dbc.Alert("Error loading options chain", color='danger')
            
            chain_data = response.json()
            chain = chain_data.get('options', [])
            
            # Format for table
            table_data = []
            for option in chain:
                table_data.append({
                    'type': option.get('type', ''),
                    'strike': option.get('strike', 0),
                    'bid': f"${option.get('bid', 0):.2f}",
                    'ask': f"${option.get('ask', 0):.2f}",
                    'last': f"${option.get('last', 0):.2f}",
                    'volume': option.get('volume', 0),
                    'open_interest': option.get('openInterest', 0),
                    'implied_volatility': f"{option.get('iv', 0)*100:.1f}%",
                    'delta': f"{option.get('delta', 0):.3f}",
                    'option_symbol': option.get('symbol', '')
                })
            
            return table_data, dbc.Alert(
                f"Loaded {len(table_data)} options for {ticker} exp {expiration}", 
                color='success', dismissable=True
            )
        
        except Exception as e:
            logger.error(f"Error loading options chain: {e}")
            return [], dbc.Alert(f"Error: {str(e)}", color='danger')
    
    # Callback 5: Pre-fill Trade Form from Chain Selection
    @app.callback(
        [Output('opt-trade-symbol', 'value'),
         Output('opt-trade-strike', 'value')],
        [Input('opt-chain-table', 'selected_rows')],
        [State('opt-chain-table', 'data')]
    )
    def prefill_trade_form(selected_rows, table_data):
        """Pre-fill trade entry form when user selects a row in options chain."""
        if not selected_rows or not table_data:
            raise PreventUpdate
        
        selected_row = table_data[selected_rows[0]]
        option_symbol = selected_row.get('option_symbol', '')
        strike = float(selected_row.get('strike', 0))
        
        return option_symbol, strike
    
    # Callback 6: Submit Manual Trade
    @app.callback(
        Output('opt-trade-status', 'children'),
        [Input('opt-submit-trade-btn', 'n_clicks')],
        [State('opt-trade-symbol', 'value'),
         State('opt-trade-strike', 'value'),
         State('opt-trade-quantity', 'value'),
         State('opt-trade-side', 'value'),
         State('opt-trade-order-type', 'value'),
         State('opt-trade-limit-price', 'value')],
        prevent_initial_call=True
    )
    def submit_manual_trade(n_clicks, symbol, strike, quantity, side, order_type, limit_price):
        """Submit a manual options trade via the options service."""
        if not n_clicks:
            raise PreventUpdate
        
        if not symbol or not strike or not quantity:
            return dbc.Alert("Please fill in all required fields", color='warning')
        
        try:
            trade_request = {
                'symbol': symbol,
                'strike': float(strike),
                'quantity': int(quantity),
                'side': side,
                'order_type': order_type
            }
            
            if order_type == 'limit' and limit_price:
                trade_request['limit_price'] = float(limit_price)
            
            response = requests.post(
                f'{OPTIONS_SERVICE_URL}/trade',
                json=trade_request,
                timeout=10
            )
            
            if response.status_code == 200:
                result = response.json()
                return dbc.Alert(
                    f"✅ Trade submitted: {result.get('message', 'Success')}", 
                    color='success', dismissable=True
                )
            else:
                error_msg = response.json().get('detail', 'Unknown error')
                return dbc.Alert(f"❌ Trade rejected: {error_msg}", color='danger')
        
        except Exception as e:
            logger.error(f"Error submitting trade: {e}")
            return dbc.Alert(f"Error: {str(e)}", color='danger')
    
    # Callback 7: Load Manual Positions
    @app.callback(
        Output('opt-manual-positions-table', 'data'),
        [Input('opt-submit-trade-btn', 'n_clicks'),
         Input('opt-monitor-interval', 'n_intervals')]
    )
    def load_manual_positions(n_clicks, n_intervals):
        """Load user's manual options positions."""
        try:
            response = requests.get(f'{OPTIONS_SERVICE_URL}/positions', timeout=5)
            
            if response.status_code != 200:
                return []
            
            positions_data = response.json()
            positions = positions_data.get('positions', [])
            
            # Format for table (same as automated positions)
            table_data = []
            for pos in positions:
                table_data.append({
                    'symbol': pos.get('symbol', ''),
                    'option_type': pos.get('option_type', ''),
                    'strike': f"${pos.get('strike', 0)}",
                    'expiration': pos.get('expiration', ''),
                    'quantity': pos.get('qty', 0),
                    'avg_price': f"${pos.get('avg_entry_price', 0):.2f}",
                    'current_price': f"${pos.get('current_price', 0):.2f}",
                    'pnl': f"${pos.get('unrealized_pl', 0):.2f}",
                    'pnl_pct': f"{pos.get('unrealized_plpc', 0)*100:.2f}%"
                })
            
            return table_data
        
        except Exception as e:
            logger.error(f"Error loading manual positions: {e}")
            return []
    
    # Callback 8: Generate P&L Chart
    @app.callback(
        [Output('pnl-chart', 'figure'),
         Output('pnl-max-profit', 'children'),
         Output('pnl-max-loss', 'children'),
         Output('pnl-breakeven', 'children'),
         Output('pnl-risk-reward', 'children')],
        [Input('pnl-generate-btn', 'n_clicks')],
        [State('pnl-stock-price', 'value'),
         State('pnl-option-type', 'value'),
         State('pnl-side', 'value'),
         State('pnl-strike', 'value'),
         State('pnl-premium', 'value'),
         State('pnl-quantity', 'value')]
    )
    def generate_pnl_chart(n_clicks, stock_price, option_type, side, strike, premium, quantity):
        """Generate P&L profile chart for an options position."""
        if not n_clicks:
            raise PreventUpdate
        
        try:
            stock_price = float(stock_price)
            strike = float(strike)
            premium = float(premium)
            quantity = int(quantity)
            
            # Create price range for chart (±30% from current price)
            price_range = np.linspace(stock_price * 0.7, stock_price * 1.3, 100)
            
            # Calculate P&L at expiration for each price point
            pnl_values = []
            for price in price_range:
                if option_type == 'call':
                    intrinsic_value = max(0, price - strike)
                else:  # put
                    intrinsic_value = max(0, strike - price)
                
                if side == 'buy':
                    pnl = (intrinsic_value - premium) * 100 * quantity
                else:  # sell
                    pnl = (premium - intrinsic_value) * 100 * quantity
                
                pnl_values.append(pnl)
            
            # Calculate key metrics
            max_profit = max(pnl_values)
            max_loss = min(pnl_values)
            
            # Find breakeven
            breakeven = None
            for i, pnl in enumerate(pnl_values):
                if i > 0 and (pnl_values[i-1] * pnl) <= 0:  # Sign change
                    breakeven = price_range[i]
                    break
            
            risk_reward = abs(max_profit / max_loss) if max_loss != 0 else 0
            
            # Create chart
            fig = go.Figure()
            
            fig.add_trace(go.Scatter(
                x=price_range,
                y=pnl_values,
                mode='lines',
                name='P&L at Expiration',
                line=dict(color='blue', width=3)
            ))
            
            # Add zero line
            fig.add_hline(y=0, line_dash="dash", line_color="gray")
            
            # Add current price line
            fig.add_vline(x=stock_price, line_dash="dot", line_color="green", 
                         annotation_text="Current Price")
            
            # Add breakeven line
            if breakeven:
                fig.add_vline(x=breakeven, line_dash="dot", line_color="orange", 
                             annotation_text="Breakeven")
            
            fig.update_layout(
                title=f"{option_type.upper()} {side.upper()} - Strike ${strike}",
                xaxis_title="Stock Price at Expiration",
                yaxis_title="Profit/Loss ($)",
                hovermode='x unified',
                height=500
            )
            
            return (
                fig,
                f"${max_profit:.2f}",
                f"${max_loss:.2f}",
                f"${breakeven:.2f}" if breakeven else "N/A",
                f"{risk_reward:.2f}"
            )
        
        except Exception as e:
            logger.error(f"Error generating P&L chart: {e}")
            empty_fig = go.Figure()
            return empty_fig, "$0.00", "$0.00", "$0.00", "0.00"
    
    # Callback 9: Generate Strategy Code
    @app.callback(
        [Output('strategy-code-output', 'value'),
         Output('strategy-status-message', 'children')],
        [Input('generate-strategy-btn', 'n_clicks')],
        [State('strategy-name', 'value'),
         State('strategy-type', 'value'),
         State('strategy-symbols', 'value'),
         State('strategy-max-position', 'value'),
         State('strategy-min-volume', 'value'),
         State('strategy-target-dte', 'value'),
         State('strategy-min-delta', 'value'),
         State('strategy-max-delta', 'value'),
         State('strategy-min-premium', 'value')]
    )
    def generate_strategy_code(n_clicks, name, strategy_type, symbols, max_pos, 
                              min_vol, target_dte, min_delta, max_delta, min_premium):
        """Generate strategy code based on user inputs."""
        if not n_clicks or not name:
            raise PreventUpdate
        
        # Generate Python code for the strategy
        code = f'''"""
{name.replace('_', ' ').title()} Strategy
Auto-generated strategy based on {strategy_type} template
"""

from strategies.base_strategy import BaseStrategy
from typing import Dict, List
import logging

logger = logging.getLogger(__name__)


class {name.replace('_', ' ').title().replace(' ', '')}Strategy(BaseStrategy):
    """
    {strategy_type.replace('_', ' ').title()} strategy implementation.
    """
    
    def __init__(self, config: Dict = None):
        super().__init__(config)
        self.name = "{name}"
        
        # Strategy parameters
        self.symbols = {symbols.split(',') if symbols else ['SPY']}
        self.max_position_size = {max_pos or 5}
        self.min_volume = {min_vol or 100}
        self.target_dte = {target_dte or 30}
        self.min_delta = {min_delta or 0.2}
        self.max_delta = {max_delta or 0.4}
        self.min_premium = {min_premium or 0.5}
        
        logger.info(f"Initialized {{self.name}} strategy")
    
    def generate_signals(self, data: Dict) -> List[Dict]:
        """
        Generate trading signals based on strategy criteria.
        """
        signals = []
        
        try:
            ticker = data.get('ticker')
            quote = data.get('quote', {{}})
            options_chain = data.get('options_chain', [])
            positions = data.get('positions', [])
            account = data.get('account', {{}})
            
            stock_price = quote.get('c', 0)
            
            # Strategy logic for {strategy_type}
            for option in options_chain:
                # Filter by option type
                {'if strategy_type == "covered_call":'}
                if option['type'] != 'CALL':
                    continue
                {'elif strategy_type == "cash_secured_put":'}
                if option['type'] != 'PUT':
                    continue
                {'else:'}
                # Custom filtering logic here
                pass
                
                # Check volume
                if option.get('volume', 0) < self.min_volume:
                    continue
                
                # Check delta range
                delta = abs(option.get('delta', 0))
                if delta < self.min_delta or delta > self.max_delta:
                    continue
                
                # Check days to expiration
                dte = option.get('dte', 0)
                if abs(dte - self.target_dte) > 7:  # Within 7 days of target
                    continue
                
                # Check minimum premium
                premium = option.get('bid', 0)
                if premium < self.min_premium:
                    continue
                
                # Generate signal
                action = 'BUY' if '{strategy_type}' == 'credit_spread' else 'SELL'
                signals.append({{
                    'action': action,
                    'symbol': option['symbol'],
                    'quantity': min(self.max_position_size, 2),
                    'reason': f"{{strategy_type}} at delta={{delta:.2f}}, premium=${{premium:.2f}}",
                    'confidence': 0.75,
                    'option_type': option['type'],
                    'strike': option['strike'],
                    'expiration': option.get('expiration', '')
                }})
            
            logger.info(f"{{self.name}} generated {{len(signals)}} signals for {{ticker}}")
            
        except Exception as e:
            logger.error(f"Error generating signals: {{e}}")
        
        return signals
'''
        
        status_msg = dbc.Alert([
            html.H6("✓ Strategy Code Generated!", className="alert-heading"),
            html.P(f"Strategy: {name}"),
            html.P(f"Type: {strategy_type.replace('_', ' ').title()}"),
            html.Hr(),
            html.P("Next steps:", className="mb-1"),
            html.Ol([
                html.Li(f"Save this code to strategies/{name}.py"),
                html.Li(f"Add configuration to options_config.yaml"),
                html.Li("Test the strategy using the Test button or API")
            ])
        ], color="success")
        
        return code, status_msg
    
    # Callback 10: Save Strategy
    @app.callback(
        Output('strategy-status-message', 'children', allow_duplicate=True),
        [Input('save-strategy-btn', 'n_clicks')],
        [State('strategy-name', 'value'),
         State('strategy-code-output', 'value')],
        prevent_initial_call=True
    )
    def save_strategy(n_clicks, name, code):
        """Save generated strategy code to services/options_service/strategies/ folder."""
        if not n_clicks or not name or not code:
            raise PreventUpdate
        
        try:
            from pathlib import Path
            
            # Ensure strategies directory exists in options service
            strategies_dir = Path(__file__).parent.parent / 'services' / 'options_service' / 'strategies'
            strategies_dir.mkdir(parents=True, exist_ok=True)
            
            # Save strategy file
            strategy_file = strategies_dir / f"{name}.py"
            with open(strategy_file, 'w') as f:
                f.write(code)
            
            logger.info(f"Saved strategy to {strategy_file}")
            
            return dbc.Alert([
                html.H6("✓ Strategy Saved Successfully!", className="alert-heading"),
                html.P(f"File: services/options_service/strategies/{name}.py"),
                html.Hr(),
                html.P("The strategy has been saved and is ready to use."),
                html.P("You can now test it using the Test Strategy button.")
            ], color="success")
        
        except Exception as e:
            logger.error(f"Error saving strategy: {e}")
            return dbc.Alert(f"Error saving strategy: {str(e)}", color="danger")
    
    # Callback 11: Test Strategy
    @app.callback(
        Output('strategy-status-message', 'children', allow_duplicate=True),
        [Input('test-strategy-btn', 'n_clicks')],
        [State('strategy-name', 'value'),
         State('strategy-symbols', 'value')],
        prevent_initial_call=True
    )
    def test_strategy(n_clicks, name, symbols):
        """Test the strategy against current market data."""
        if not n_clicks or not name:
            raise PreventUpdate
        
        try:
            from pathlib import Path
            import sys
            import importlib.util
            
            # Load the strategy module
            strategies_dir = Path(__file__).parent.parent / 'services' / 'options_service' / 'strategies'
            strategy_file = strategies_dir / f"{name}.py"
            
            if not strategy_file.exists():
                return dbc.Alert(
                    "Strategy file not found. Please save the strategy first.",
                    color="warning"
                )
            
            # Import the strategy
            spec = importlib.util.spec_from_file_location(name, strategy_file)
            strategy_module = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(strategy_module)
            
            # Find the strategy class
            strategy_class = None
            for attr_name in dir(strategy_module):
                attr = getattr(strategy_module, attr_name)
                if isinstance(attr, type) and attr_name.endswith('Strategy') and attr_name != 'BaseStrategy':
                    strategy_class = attr
                    break
            
            if not strategy_class:
                return dbc.Alert("No strategy class found in file.", color="danger")
            
            # Instantiate strategy
            strategy = strategy_class()
            
            # Get market data for testing
            test_symbol = (symbols.split(',')[0] if symbols else 'SPY').strip()
            
            quote_response = requests.get(f'{OPTIONS_SERVICE_URL}/quote/{test_symbol}', timeout=5)
            quote = quote_response.json() if quote_response.status_code == 200 else {}
            
            exp_response = requests.get(f'{OPTIONS_SERVICE_URL}/expirations/{test_symbol}', timeout=5)
            expirations = exp_response.json().get('expirations', [])
            
            if not expirations:
                return dbc.Alert("No expirations available for testing.", color="warning")
            
            # Get options chain for first expiration
            chain_response = requests.get(
                f'{OPTIONS_SERVICE_URL}/options-chain/{test_symbol}?expiration={expirations[0]}',
                timeout=5
            )
            options_chain = chain_response.json().get('options', [])
            
            # Prepare data for strategy
            data = {
                'ticker': test_symbol,
                'quote': quote,
                'options_chain': options_chain,
                'positions': [],
                'account': {}
            }
            
            # Run strategy
            signals = strategy.generate_signals(data)
            
            # Format results
            if signals:
                signal_items = [
                    html.Li(f"{s.get('action', 'N/A')} {s.get('symbol', 'N/A')} "
                           f"Strike ${s.get('strike', 0)} "
                           f"Exp {s.get('expiration', 'N/A')} "
                           f"Qty {s.get('quantity', 0)}")
                    for s in signals[:5]  # Show first 5
                ]
                
                return dbc.Alert([
                    html.H6(f"✓ Strategy Test Complete!", className="alert-heading"),
                    html.P(f"Generated {len(signals)} signal(s) for {test_symbol}"),
                    html.Hr(),
                    html.P("Signals:"),
                    html.Ul(signal_items),
                    html.P(f"Using expiration: {expirations[0]}", className="small", style={'color': '#000000'})
                ], color="success")
            else:
                return dbc.Alert([
                    html.H6("Strategy Test Complete", className="alert-heading"),
                    html.P(f"No signals generated for {test_symbol}"),
                    html.P("This could mean market conditions don't meet strategy criteria.", 
                          style={'color': '#000000'})
                ], color="info")
        
        except Exception as e:
            logger.error(f"Error testing strategy: {e}")
            return dbc.Alert(f"Error testing strategy: {str(e)}", color="danger")
