from datetime import datetime, timedelta

logger = logging.getLogger(__name__)

# Options Service endpoint
OPTIONS_SERVICE_URL = os.getenv('OPTIONS_SERVICE_URL', 'http://localhost:8060')


def layout():
    """Build the Options Lab tab layout with three main panels."""
    return create_layout()


