# Weekly picks environment file
# Copy to scripts/weekly_picks.env and set mode 600 (chmod 600 scripts/weekly_picks.env)

# Alpaca keys
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Optional Alpaca endpoint
# APCA_ENDPOINT=

# Path overrides
DASH_ROOT=/path/to/Dash
PICKS_FILE=${DASH_ROOT}/models/weekly_run/weeklypicks1006.csv
FEATURES_FILE=${DASH_ROOT}/data/weekly_enriched_with_alpaca_prices.parquet
OUT_FILE=${DASH_ROOT}/models/weekly_run/weeklypicks1006.open.csv

# Execution mode (default dry-run). Set EXECUTE=1 to enable live order submission.
EXECUTE=0

# Account: PAPER or LIVE
ACCOUNT=PAPER

# Explicit approval for live execution. Set to 1 to allow live orders. Also the wrapper supports --force.
ALLOW_LIVE=0

# Safety caps (optional)
# Maximum total dollars to spend this run (can be empty for no cap)
MAX_ALLOCATION=
# Maximum percent of buying power to spend on any single ticker (0.0-1.0)
MAX_PERCENT_PER_TICKER=

# Logging
LOG_FILE=${DASH_ROOT}/dashboard.log
