"""
Safe integrated dashboard shim.

This file intentionally keeps a small wrapper that imports the canonical
`index`/`app` modules to avoid duplicating tab-loading logic. It also
ensures test-friendly `data-testid` attributes are present on tab panes
by post-processing the layout returned by the canonical creator.

This is a minimal, low-risk change to restore the integrated dashboard
entrypoint while preserving the existing `index.py` implementation.
"""

import logging

try:
    # Defer importing Dash components until available in environment
    from dash import html
except Exception:  # pragma: no cover - environment imports may vary
    html = None

logger = logging.getLogger(__name__)

# Import the canonical app from index.py (which builds the Dash app)
try:
    # index.py exposes `app` and `server` and a create_layout function
    from .index import app, server, create_layout as _create_layout
except Exception:
    # Fallbacks for alternate layouts
    try:
        from .app import app, server
        _create_layout = getattr(app, 'layout', lambda: None)
    except Exception:
        app = None
        server = None
        _create_layout = lambda: None


def _ensure_test_attrs(layout):
    """Walk the returned layout and add `data-testid` attributes to
    any pane divs missing them. This keeps test selectors stable without
    changing individual tab modules.
    """
    if layout is None or html is None:
        return layout

    def _safe_get_props(node):
        # Try common places where component props live
        return getattr(node, 'props', None) or getattr(node, '__dict__', None) or {}

    def walk(node):
        try:
            props = _safe_get_props(node)
            if isinstance(props, dict):
                tab_id = props.get('tab_id') or props.get('tabId') or props.get('id')
                if isinstance(tab_id, str) and str(tab_id).startswith('tab-'):
                    children = props.get('children')
                    if children is not None:
                        try:
                            # Wrap children in a Div with test ids (best-effort)
                            props['children'] = html.Div(
                                children=children,
                                id=f"tab-pane-{str(tab_id).replace('tab-', '')}",
                                **{'data-testid': f"{tab_id}", 'data-test-id': f"{tab_id}"}
                            )
                        except Exception:
                            # Be defensive: if dash.Html is not available or props can't be mutated
                            pass
                # Recurse into children
                children = props.get('children')
                if children:
                    if isinstance(children, (list, tuple)):
                        for c in children:
                            walk(c)
                    else:
                        walk(children)
        except Exception:
            # Swallow to avoid breaking the import-time shim
            return

    try:
        walk(layout)
    except Exception:
        logger.exception('Error ensuring test attrs on layout')
    return layout


# Apply the layout transformation at import time so downstream callers
# see the modified layout.
if _create_layout and callable(_create_layout):
    try:
        _layout = _create_layout()
        _layout = _ensure_test_attrs(_layout)
        if app is not None:
            # Ensure app.layout returns the processed layout
            # If app.layout is a function, replace it; otherwise assign value
            try:
                app.layout = lambda: _layout
            except Exception:
                app.layout = _layout
    except Exception:
        logger.exception('Failed to create wrapped layout')


# Expose app/server for external runners
__all__ = ['app', 'server']
