# Portfolio Dashboard Service Docker Image
# Extends the base image with portfolio-specific logic

FROM fin-dash-base:latest

# Set working directory
WORKDIR /app

# Copy service file
COPY services/portfolio_dashboard_service.py ./services/

# Copy utilities needed by the service
COPY utils/ ./utils/

# Expose port
EXPOSE 8057

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:8057/health || exit 1

# Run the service
CMD ["python", "-m", "uvicorn", "services.portfolio_dashboard_service:app", "--host", "0.0.0.0", "--port", "8057"]
