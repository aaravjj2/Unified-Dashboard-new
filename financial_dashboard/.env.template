# =============================================================================
# FINANCIAL DASHBOARD ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and replace placeholder values with actual credentials
# Never commit .env to version control!

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_PASSWORD=postgres_dev_pass
DB_HOST=postgres
DB_PORT=5432
DB_NAME=portfolio
DB_USER=postgres

# =============================================================================
# API GATEWAY SECURITY
# =============================================================================
# Comma-separated list of valid API keys for gateway authentication
API_GATEWAY_KEYS=dev-key-12345,prod-key-67890

# =============================================================================
# TRADING API - ALPACA
# =============================================================================
# Get your keys from: https://app.alpaca.markets/
# Use Paper Trading keys for development, Live keys for production
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here

# Legacy fallback names (automatically supported by code):
# APCA_API_KEY_ID=your_alpaca_api_key_here
# APCA_API_SECRET_KEY=your_alpaca_api_secret_here

# =============================================================================
# MARKET DATA API - FINNHUB
# =============================================================================
# Get your key from: https://finnhub.io/
# Free tier: 60 API calls/minute
FINNHUB_API_KEY=your_finnhub_api_key_here

# Optional: Second key for rotation (doubles rate limit)
FINNHUB2_API_KEY=your_second_finnhub_key_here

# =============================================================================
# MARKET DATA API - POLYGON
# =============================================================================
# Get your key from: https://polygon.io/
# Used as tertiary fallback after Finnhub and Alpaca
POLYGON_API_KEY=your_polygon_api_key_here

# =============================================================================
# SENTIMENT ANALYSIS APIs (Optional)
# =============================================================================
# Reddit API - for social sentiment analysis
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# News API - for news sentiment
NEWS_API_KEY=your_newsapi_key_here

# Google Gemini API - for AI-powered analysis
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# MLFLOW & MINIO CONFIGURATION
# =============================================================================
# MinIO S3-compatible storage credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MLFLOW_S3_ENDPOINT_URL=http://minio:9000

# MLflow backend
MLFLOW_BACKEND_STORE_URI=postgresql://postgres:${DB_PASSWORD:-postgres_dev_pass}@postgres:5432/mlflow
MLFLOW_DEFAULT_ARTIFACT_ROOT=s3://mlflow-artifacts

# =============================================================================
# SERVICE URLs (Internal Docker Network)
# =============================================================================
# These are automatically set by docker-compose but can be overridden
DASHBOARD_URL=http://dashboard:8050
MARKET_TRENDS_URL=http://market_trends:8050
MARKET_FORECAST_URL=http://market_forecast:8051
ANALYSIS_SERVICE_URL=http://analysis:8054
PORTFOLIO_SERVICE_URL=http://portfolio:8056
PORTFOLIO_DASHBOARD_URL=http://portfolio_dashboard:8057
RESEARCH_URL=http://research:8058
OPTIONS_URL=http://options_service:8060
CHATBOT_URL=http://chatbot:8062
BACKTESTER_URL=http://backtester:8064
NEWS_ANALYSIS_URL=http://news_analysis:8006

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
DASH_PORT=8050
LOG_LEVEL=INFO
PYTHONPATH=/app

# =============================================================================
# DAGSTER CONFIGURATION
# =============================================================================
DAGSTER_POSTGRES_USER=postgres
DAGSTER_POSTGRES_PASSWORD=${DB_PASSWORD:-postgres_dev_pass}
DAGSTER_POSTGRES_DB=dagster
DAGSTER_POSTGRES_HOST=postgres
DAGSTER_POSTGRES_PORT=5432

# =============================================================================
# QUICK START INSTRUCTIONS
# =============================================================================
# 1. Copy this file: cp .env.template .env
# 2. Edit .env and replace all "your_*_here" placeholders with real credentials
# 3. Build and launch: bash build_and_launch.sh
# 4. Access dashboard: http://localhost:8050
# 5. Access API gateway: http://localhost:8000
# 6. Access MLflow UI: http://localhost:5000
# 7. Access Dagit UI: http://localhost:3000
# 8. Access MinIO Console: http://localhost:9001

# =============================================================================
# SECURITY NOTES
# =============================================================================
# - Never commit .env to git (already in .gitignore)
# - Use separate credentials for development vs production
# - Rotate API keys regularly
# - Use strong, unique passwords for DB_PASSWORD
# - Generate secure API_GATEWAY_KEYS: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
