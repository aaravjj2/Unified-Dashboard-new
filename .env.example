# Unified Dashboard Environment Configuration
# Copy to .env and fill in your API keys

# ============================================
# LLM Backend Configuration
# ============================================

# LLM_BACKEND: Choose which LLM backend to use
# Options: 'huggingface', 'openai', 'mock'
# Default: 'mock' (for testing without API keys)
LLM_BACKEND=mock

# --------------------------------------------
# HuggingFace Configuration (if LLM_BACKEND=huggingface)
# --------------------------------------------

# Model name from HuggingFace Hub
HF_MODEL_NAME=TinyLlama/TinyLlama-1.1B-Chat-v1.0

# Quantization settings (mutually exclusive)
# HF_LOAD_IN_8BIT=1
# HF_LOAD_IN_4BIT=1

# Max generation length
HF_MAX_LENGTH=512

# LoRA weights path (optional)
# HF_LORA_PATH=/path/to/lora/weights

# --------------------------------------------
# OpenAI Configuration (if LLM_BACKEND=openai)
# --------------------------------------------

# OpenAI API Key (required for openai backend)
# OPENAI_API_KEY=sk-your-api-key-here

# Model name
# OPENAI_MODEL=gpt-3.5-turbo

# Generation settings
# OPENAI_MAX_TOKENS=500
# OPENAI_TEMPERATURE=0.7

# ============================================
# Options Lab Configuration
# ============================================

# Enable Alpaca options data (recommended for real-time chains)
# Set to '1' to enable Alpaca options fetching
# OPTIONS_USE_ALPACA=1

# Alpaca API Credentials (required if OPTIONS_USE_ALPACA=1)
# Get keys from: https://alpaca.markets/
# APCA_API_KEY_ID=your-alpaca-key-id
# APCA_API_SECRET_KEY=your-alpaca-secret-key
# APCA_API_BASE_URL=https://paper-api.alpaca.markets

# ============================================
# RAG Data Ingestion Configuration
# ============================================

# News API Keys (for automated RAG updates)
# Alpaca News API (already uses APCA_API_KEY_ID above)
# FINNHUB_API_KEY=your-finnhub-key
# NEWSAPI_KEY=your-newsapi-key

# Ingestion frequency in hours
# RAG_INGESTION_INTERVAL_HOURS=6

# ============================================
# Chatbot Service Configuration
# ============================================

# Chatbot service port
# CHATBOT_PORT=8062

# Chatbot model backend (uses LLM_BACKEND if not specified)
# CHATBOT_MODEL_BACKEND=mock

# ============================================
# Testing Configuration
# ============================================

# Enable debug mode
# DEBUG=1

# Dashboard test port
# DASHBOARD_TEST_PORT=8051

# Playwright browser settings
# PLAYWRIGHT_HEADLESS=0
# PLAYWRIGHT_SLOW_MO=100
