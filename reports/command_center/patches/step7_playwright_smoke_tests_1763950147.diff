+    
+    # Verify sentiment widget elements
+    sentiment_card = page.locator("#cc-sentiment-card")
+    expect(sentiment_card).to_be_visible(timeout=TIMEOUT)
+    
+    sentiment_indicator = page.locator("#cc-sentiment-indicator")
+    expect(sentiment_indicator).to_be_visible(timeout=TIMEOUT)
+    
+    sentiment_score = page.locator("#cc-sentiment-score")
+    expect(sentiment_score).to_be_visible(timeout=TIMEOUT)
+    
+    save_screenshot(page, "05_sentiment_widget")
+    
+    print("✅ TEST 4 PASSED: Sentiment widget displays")
+
+
