+    print("✅ TEST 7 PASSED: Chat widget interactive")
+
+
+def test_admin_tools_visible(page: Page):
+    """
+    TEST 8: Admin tools area is accessible
+    
+    Acceptance:
+        - Admin area with id="cc-admin-area" is visible
+        - Callback map button with id="cc-callback-map-btn" is visible
