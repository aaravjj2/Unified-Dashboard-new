+def test_chat_widget_interactive(page: Page):
+    """
+    TEST 7: Chat widget is interactive
+    
+    Acceptance:
+        - Chat input with id="cc-chat-input" is visible
+        - Chat send button with id="cc-chat-send" is visible and enabled
