+"""
+Command Center Playwright Headed Smoke Tests
+CRITICAL: HEADLESS MODE FORBIDDEN - Must run in headed mode for visual verification
+
+Test Coverage:
+1. Command Center tab loads and renders stable UI IDs
+2. Smoke test button functional
+3. Sentiment widget displays data
+4. Portfolio snapshot loads
+5. Chat widget interactive
+6. Jobs area visible
+7. Admin tools accessible
+
+Environment Requirements:
+    - Dashboard running on http://localhost:8050
+    - Playwright installed: `playwright install chromium`
+    - HEADED mode only (no headless)
+
+Run:
+    pytest tests/playwright/cc_headed_smoke.py -v --headed
+"""
+
+import pytest
+import time
+import json
+from pathlib import Path
+from playwright.sync_api import sync_playwright, Page, expect
+
+# Test configuration
+DASHBOARD_URL = "http://localhost:8050"
+SCREENSHOT_DIR = Path("reports/command_center/screenshots")
+DOM_DIR = Path("reports/command_center/dom")
+TIMEOUT = 30000  # 30 seconds
+
+
+@pytest.fixture(scope="module")
+def browser_context():
+    """
+    Launch browser in HEADED mode
+    CRITICAL: headless=False is mandatory
+    """
+    with sync_playwright() as p:
+        browser = p.chromium.launch(
+            headless=False,  # MANDATORY: headed mode only
+            slow_mo=500  # Slow down for visual verification
+        )
+        context = browser.new_context(
+            viewport={"width": 1920, "height": 1080},
+            user_agent="PlaywrightCCTest/1.0"
+        )
+        yield context
+        context.close()
+        browser.close()
+
+
+@pytest.fixture
+def page(browser_context):
+    """Create new page for each test"""
+    page = browser_context.new_page()
+    yield page
+    page.close()
+
+
+def save_screenshot(page: Page, name: str):
+    """Save screenshot to reports directory"""
+    SCREENSHOT_DIR.mkdir(parents=True, exist_ok=True)
+    screenshot_path = SCREENSHOT_DIR / f"{name}_{int(time.time())}.png"
+    page.screenshot(path=str(screenshot_path), full_page=True)
+    print(f"📸 Screenshot saved: {screenshot_path}")
+
+
+def save_dom(page: Page, name: str):
+    """Save DOM snapshot to reports directory"""
+    DOM_DIR.mkdir(parents=True, exist_ok=True)
+    dom_path = DOM_DIR / f"{name}_{int(time.time())}.html"
+    dom_path.write_text(page.content(), encoding='utf-8')
+    print(f"📄 DOM saved: {dom_path}")
+
+
+def test_command_center_tab_loads(page: Page):
+    """
+    TEST 1: Command Center tab loads and renders stable UI IDs
+    
+    Acceptance:
+        - Dashboard loads successfully
+        - Command Center tab exists
+        - Clicking Command Center tab shows content
+        - Header with id="cc-header" is visible
+    """
+    print("\n🧪 TEST 1: Command Center tab loads")
+    
+    # Navigate to dashboard
+    page.goto(DASHBOARD_URL, wait_until="networkidle", timeout=TIMEOUT)
+    save_screenshot(page, "01_dashboard_loaded")
+    
+    # Find Command Center tab link
+    # Expected text: "🎯 Command Center"
+    cc_tab = page.locator("text=/Command Center/i").first
+    expect(cc_tab).to_be_visible(timeout=TIMEOUT)
+    
+    # Click Command Center tab
+    cc_tab.click()
+    page.wait_for_timeout(2000)  # Wait for tab content to render
+    
+    save_screenshot(page, "02_cc_tab_clicked")
+    save_dom(page, "02_cc_tab_dom")
+    
+    # Verify header exists with stable ID
+    header = page.locator("#cc-header")
+    expect(header).to_be_visible(timeout=TIMEOUT)
+    expect(header).to_contain_text("Command Center")
+    
+    print("✅ TEST 1 PASSED: Command Center tab loads")
+
+
+def test_system_status_banner(page: Page):
+    """
+    TEST 2: System status banner displays
+    
+    Acceptance:
+        - System status banner with id="cc-system-status" is visible
+        - Status text is present
+    """
+    print("\n🧪 TEST 2: System status banner")
+    
+    page.goto(DASHBOARD_URL, wait_until="networkidle", timeout=TIMEOUT)
+    page.locator("text=/Command Center/i").first.click()
+    page.wait_for_timeout(1000)
+    
+    # Verify system status banner
+    status_banner = page.locator("#cc-system-status")
+    expect(status_banner).to_be_visible(timeout=TIMEOUT)
+    
+    # Verify status text exists
+    status_text = page.locator("#cc-status-text")
+    expect(status_text).to_be_visible(timeout=TIMEOUT)
+    
+    save_screenshot(page, "03_system_status")
+    
+    print("✅ TEST 2 PASSED: System status banner displays")
+
+
+def test_smoke_test_button(page: Page):
+    """
+    TEST 3: Smoke test button is functional
+    
+    Acceptance:
+        - Button with id="cc-run-smoke-btn" is visible
+        - Button is clickable
+    """
+    print("\n🧪 TEST 3: Smoke test button")
+    
+    page.goto(DASHBOARD_URL, wait_until="networkidle", timeout=TIMEOUT)
+    page.locator("text=/Command Center/i").first.click()
+    page.wait_for_timeout(1000)
+    
+    # Verify smoke test button
+    smoke_btn = page.locator("#cc-run-smoke-btn")
+    expect(smoke_btn).to_be_visible(timeout=TIMEOUT)
+    expect(smoke_btn).to_be_enabled()
+    
+    save_screenshot(page, "04_smoke_button")
+    
+    # Click button (don't wait for completion - just verify it's clickable)
+    smoke_btn.click()
+    page.wait_for_timeout(500)
+    
+    print("✅ TEST 3 PASSED: Smoke test button functional")
+
+
+def test_sentiment_widget_visible(page: Page):
+    """
+    TEST 4: Sentiment widget displays
+    
+    Acceptance:
+        - Sentiment card with id="cc-sentiment-card" is visible
+        - Sentiment indicator with id="cc-sentiment-indicator" is visible
