@@ -0,0 +1,263 @@
+"""
+Action Executor - Safe execution pipeline for chat-suggested actions
+Handles action validation, confirmation, and execution with audit logging
+"""
+
+import os
+import time
+import logging
+import json
+from typing import Dict, Any, Optional
+from pathlib import Path
+
+logger = logging.getLogger(__name__)
+
+
+class ActionExecutor:
+    """
+    Action execution engine with safety gates
+    
+    Supported actions:
+    - create_paper_order: Create paper trading order (NO LIVE TRADING)
+    - open_tab: Navigate to specific tab
+    - run_backtest: Trigger backtest with parameters
+    
+    Safety:
+    - Requires user confirmation
+    - Validates action schema
+    - Logs all executions
+    - Blocks live trading attempts
+    """
+    
+    VALID_ACTIONS = {
+        "create_paper_order": {
+            "required_fields": ["symbol", "qty", "side", "type"],
+            "optional_fields": ["limit_price", "stop_price", "time_in_force"]
+        },
+        "open_tab": {
+            "required_fields": ["tab_name"],
+            "optional_fields": ["ticker"]
+        },
+        "run_backtest": {
+            "required_fields": ["strategy", "ticker", "start_date", "end_date"],
+            "optional_fields": ["parameters"]
+        }
+    }
+    
+    def __init__(self, audit_log_path: str = "reports/chat_agent/logs/action_audit.log"):
+        """
+        Initialize action executor
+        
+        Args:
+            audit_log_path: Path to audit log file
+        """
+        self.audit_log_path = Path(audit_log_path)
+        self.audit_log_path.parent.mkdir(parents=True, exist_ok=True)
+        
+        # Ensure LIVE_ORDER_ALLOWED is false
+        self.allow_live = os.getenv("LIVE_ORDER_ALLOWED", "false").lower() == "true"
+        if self.allow_live:
+            logger.error("LIVE_ORDER_ALLOWED=true detected! Forcing to false for safety")
+            self.allow_live = False
+    
+    def validate_action(self, action_type: str, payload: Dict[str, Any]) -> tuple[bool, Optional[str]]:
+        """
+        Validate action schema
+        
+        Args:
+            action_type: Type of action
+            payload: Action payload
+            
+        Returns:
+            (valid, error_message) tuple
+        """
+        if action_type not in self.VALID_ACTIONS:
+            return False, f"Unknown action type: {action_type}"
+        
+        schema = self.VALID_ACTIONS[action_type]
+        required = schema['required_fields']
+        
+        # Check required fields
+        for field in required:
+            if field not in payload:
+                return False, f"Missing required field: {field}"
+        
+        # Specific validation for paper orders
+        if action_type == "create_paper_order":
+            # Reject any live trading attempts
+            if payload.get('paper', True) is False:
+                return False, "Live trading is BLOCKED. Only paper orders allowed."
+            
+            # Validate side
+            if payload['side'] not in ['buy', 'sell']:
+                return False, f"Invalid side: {payload['side']}. Must be 'buy' or 'sell'"
+            
+            # Validate order type
+            if payload['type'] not in ['market', 'limit', 'stop', 'stop_limit']:
+                return False, f"Invalid order type: {payload['type']}"
+            
+            # Ensure quantity is positive
+            if payload['qty'] <= 0:
+                return False, "Quantity must be positive"
+        
+        return True, None
+    
+    def execute(
+        self,
+        action_id: str,
+        action_type: str,
+        payload: Dict[str, Any],
+        confirmed: bool,
+        user_id: Optional[str] = None
+    ) -> Dict[str, Any]:
+        """
+        Execute a confirmed action
+        
+        Args:
+            action_id: Unique action ID
+            action_type: Type of action
+            payload: Action payload
+            confirmed: User confirmation flag
+            user_id: Optional user identifier
+            
+        Returns:
+            Execution result dict
+        """
+        if not confirmed:
+            return {
+                "success": False,
+                "error": "Action must be confirmed by user",
+                "action_id": action_id
+            }
+        
+        # Validate
+        valid, error = self.validate_action(action_type, payload)
+        if not valid:
+            self._audit_log(action_id, action_type, payload, "REJECTED", error, user_id)
+            return {
+                "success": False,
+                "error": error,
+                "action_id": action_id
+            }
+        
+        # Execute based on action type
+        try:
+            if action_type == "create_paper_order":
+                result = self._execute_paper_order(payload)
+            elif action_type == "open_tab":
+                result = self._execute_open_tab(payload)
+            elif action_type == "run_backtest":
+                result = self._execute_backtest(payload)
+            else:
+                result = {"status": "not_implemented", "note": f"Handler for {action_type} not yet implemented"}
+            
+            self._audit_log(action_id, action_type, payload, "SUCCESS", json.dumps(result), user_id)
+            
+            return {
+                "success": True,
+                "result": result,
+                "action_id": action_id
+            }
+            
+        except Exception as e:
+            error_msg = str(e)
+            logger.error(f"Action execution failed: {e}", exc_info=True)
+            self._audit_log(action_id, action_type, payload, "FAILED", error_msg, user_id)
+            
+            return {
+                "success": False,
+                "error": error_msg,
+                "action_id": action_id
+            }
+    
+    def _execute_paper_order(self, payload: Dict[str, Any]) -> Dict[str, Any]:
+        """Execute paper order creation"""
+        # Force paper mode
+        payload['paper'] = True
+        
+        # In a full implementation, this would call the paper order service
+        # For now, create a mock order record
+        order_id = f"paper_order_{int(time.time() * 1000)}"
+        
+        logger.info(f"Paper order created: {order_id} - {payload}")
+        
+        return {
+            "order_id": order_id,
+            "symbol": payload['symbol'],
+            "qty": payload['qty'],
+            "side": payload['side'],
+            "type": payload['type'],
+            "status": "submitted",
+            "paper": True,
+            "note": "Paper order stub - full integration pending"
+        }
+    
+    def _execute_open_tab(self, payload: Dict[str, Any]) -> Dict[str, Any]:
+        """Execute tab navigation"""
+        tab_name = payload['tab_name']
+        ticker = payload.get('ticker', None)
+        
+        logger.info(f"Tab navigation: {tab_name}, ticker={ticker}")
+        
+        return {
+            "tab_name": tab_name,
+            "ticker": ticker,
+            "status": "navigated",
+            "note": "Tab navigation stub - requires frontend integration"
+        }
+    
+    def _execute_backtest(self, payload: Dict[str, Any]) -> Dict[str, Any]:
+        """Execute backtest"""
+        strategy = payload['strategy']
+        ticker = payload['ticker']
+        
+        logger.info(f"Backtest triggered: {strategy} on {ticker}")
+        
+        return {
+            "strategy": strategy,
+            "ticker": ticker,
+            "start_date": payload['start_date'],
+            "end_date": payload['end_date'],
+            "status": "queued",
+            "note": "Backtest stub - requires backend integration"
+        }
+    
+    def _audit_log(
+        self,
+        action_id: str,
+        action_type: str,
+        payload: Dict[str, Any],
+        status: str,
+        details: str,
+        user_id: Optional[str] = None
+    ):
+        """Write audit log entry"""
+        timestamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+        
+        log_entry = {
+            "timestamp": timestamp,
+            "action_id": action_id,
+            "action_type": action_type,
+            "payload": payload,
+            "status": status,
+            "details": details,
+            "user_id": user_id or "anonymous"
+        }
+        
+        try:
+            with open(self.audit_log_path, 'a') as f:
+                f.write(json.dumps(log_entry) + "\n")
+        except Exception as e:
+            logger.error(f"Failed to write audit log: {e}")
+
+
+# Global singleton
+_executor_instance: Optional[ActionExecutor] = None
+
+
+def get_executor() -> ActionExecutor:
+    """Get or create global action executor"""
+    global _executor_instance
+    if _executor_instance is None:
+        _executor_instance = ActionExecutor()
+    return _executor_instance
