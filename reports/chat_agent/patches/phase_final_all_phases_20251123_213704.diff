++            "text": "/* ========================================\n   UNIFIED FINANCIAL DASHBOARD - CUSTOM OVERRIDES\n   Phase 3 Component-Specific Fix (No Global Hacks)\n   ======================================== */\n\n/* ─────────────────────────────────────────\n   TEXT VISIBILITY - Component Targeting\n   ───────────────────────────────────────── */\n\n/* Override Bootstrap text-muted ONLY for dashboard content areas \n   (avoid breaking Bootstrap modal/tooltip native styles) */\n.tab-content .text-muted,\n.card-body .text-muted,\n.table .text-muted,\n.container .text-muted,\n.row .text-muted {\n    color: #212529 !important; /* Bootstrap's default dark gray */\n    opacity: 0.85;\n}\n\n/* ─────────────────────────────────────────\n   TABLE TEXT - Ensure Readability\n   ───────────────────────────────────────── */\n\n/* DataTables and standard tables */\n.dash-table-container table,\n.table,\ntable {\n    color: #212529; /* Dark text on light backgrounds */\n}\n\n.dash-table-container .dash-cell,\n.dash-table-container td,\n.dash-table-container th {\n    color: #212529 !important;\n}\n\n/* Portfolio tables specifically */\n#portfolio-table td,\n#portfolio-table th,\n#home-portfolio-table td,\n#home-portfolio-table th {\n    color: #212529 !important;\n}\n\n/* Market trends, weekly/monthly picks */\n.market-trends-table td,\n.market-trends-table th,\n.weekly-picks-table td,\n.weekly-picks-table th,\n.monthly-picks-table td,\n.monthly-picks-table th {\n    color: #212529 !important;\n}\n\n/* ─────────────────────────────────────────\n   METRICS & CARDS\n   ───────────────────────────────────────── */\n\n.metric-card,\n.kpi-card,\n.stat-box {\n    color: #212529;\n}\n\n.metric-value,\n.kpi-value {\n    color: #000000 !important;\n    font-weight: 600;\n}\n\n/* ─────────────────────────────────────────\n   STRATEGY LAB SUBTABS\n   ───────────────────────────────────────── */\n\n#strategy-lab-content .text-muted,\n#strategy-setup-tab .text-muted,\n#strategy-backtest-tab .text-muted,\n#strategy-execution-tab .text-muted,\n#strategy-results-tab .text-muted,\n#strategy-benchmark-tab .text-muted,\n#strategy-risk-tab .text-muted {\n    color: #212529 !important;\n}\n\n/* Accordion and collapse content */\n.accordion-body,\n.accordion-body *,\n.accordion-item .accordion-body,\n.accordion-item .accordion-body *,\n.collapse-content,\n.collapse-content *,\n.alert,\n.card-text,\np,\nsmall,\n.small {\n    color: #212529 !important;\n}\n\n/* ─────────────────────────────────────────\n   TOOLTIPS & HELP TEXT\n   ───────────────────────────────────────── */\n\n.tooltip-inner,\n.help-text,\n.info-text,\n.beginner-guide,\n.markdown,\n.markdown *,\n.dcc-markdown,\n.dcc-markdown *,\ndcc-markdown,\ndcc-markdown *,\n[class*=\"markdown\"],\n[class*=\"markdown\"] *,\n[class*=\"guide\"],\n[class*=\"guide\"] *,\n[class*=\"help\"],\n[class*=\"help\"] *,\n[class*=\"info\"],\n[class*=\"info\"] *,\n[class*=\"description\"],\n[class*=\"description\"] * {\n    color: #212529 !important;\n}\n\n/* Beginner Guide Accordion - Force ALL children to dark text */\n.accordion-item:has([title*=\"Beginner\"]) .accordion-body,\n.accordion-item:has([title*=\"Beginner\"]) .accordion-body *,\n.accordion-item:has([title*=\"beginner\"]) .accordion-body,\n.accordion-item:has([title*=\"beginner\"]) .accordion-body *,\n.accordion-item:has([title*=\"Guide\"]) .accordion-body,\n.accordion-item:has([title*=\"Guide\"]) .accordion-body * {\n    color: #212529 !important;\n}\n\n/* Preserve Bootstrap tooltip white text on dark background */\n.tooltip .tooltip-inner {\n    background-color: #000000;\n    color: #ffffff !important;\n}\n\n/* ─────────────────────────────────────────\n   FORM CONTROLS (Minimal Changes)\n   ───────────────────────────────────────── */\n\n/* Keep inputs readable without forcing dark theme */\ninput:not([type=\"checkbox\"]):not([type=\"radio\"]),\ntextarea,\nselect {\n    color: #212529;\n    background-color: #ffffff;\n    border: 1px solid #ced4da;\n}\n\n/* ─────────────────────────────────────────\n   UTILITY CLASSES\n   ───────────────────────────────────────── */\n\n.text-dark-override {\n    color: #000000 !important;\n}\n\n.bg-light-safe {\n    background-color: #f8f9fa !important;\n}\n\n/* ─────────────────────────────────────────\n   RESPONSIVE TABLE FIXES\n   ───────────────────────────────────────── */\n\n/* Prevent text wrapping in compact tables */\n.dash-table-container .dash-spreadsheet-container .cell,\n.dash-table-container .cell-table td,\n.dash-table-container .cell-table th {\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n}\n\n/* ========================================\n   END CUSTOM OVERRIDES\n   ======================================== */\n\n/* ------------------------------------------------------------------\n     Market Trends: scoped override for the actual results table\n     - The global rules above use `!important` and force dark text.\n     - Add a highly-specific selector for the real results table (not\n         the sentinel) which uses the `data-testid` set by the Dash layout\n         to restore white text in dark UI contexts.\n     ------------------------------------------------------------------ */\n[data-testid=\"market-trends-data-table\"] td,\n[data-testid=\"market-trends-data-table\"] th {\n        color: #ffffff !important;\n}\n\n/* Also ensure header cells inside the data table use full contrast */\n[data-testid=\"market-trends-data-table\"] thead th,\n[data-testid=\"market-trends-data-table\"] tbody td {\n        color: #ffffff !important;\n}\n\n/* Allow wrapping and sensible table layout for the Market Trends results table. */\n[data-testid=\"market-trends-data-table\"] td,\n[data-testid=\"market-trends-data-table\"] th {\n    white-space: normal !important;\n    word-break: break-word !important;\n}\n\n[data-testid=\"market-trends-data-table\"] {\n    table-layout: auto !important;\n}\n\n/* Ensure the Market Trends results table is fully visible on dark theme\n   - Force a dark background for the table and wrapper\n   - Force white text for all cells and headers\n   - Add a subtle border so table boundaries remain visible when screenshots are taken\n*/\n.market-trends-table-wrapper,\n[data-testid=\"market-trends-data-table\"] {\n    background-color: rgba(10,14,39,0.85) !important; /* dark translucent */\n    color: #ffffff !important;\n}\n\n[data-testid=\"market-trends-data-table\"] th,\n[data-testid=\"market-trends-data-table\"] td {\n    background-color: transparent !important;\n    color: #ffffff !important;\n    border-color: rgba(255,255,255,0.06) !important;\n}\n\n/* Ensure table remains readable even if content is loading/placeholder */\n[data-testid=\"market-trends-data-table\"] thead th {\n    background-color: rgba(255,255,255,0.04) !important;\n}\n\n"
