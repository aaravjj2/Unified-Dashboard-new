++            "text": "/* Ensure results-table CELLS (not containers) never wrap and stay compact */\n/* CRITICAL: Only apply height constraints to CELLS, not to containers! */\n#results-table .dash-cell-value, #results-table-client .dash-cell-value,\n#results-table .dash-cell, #results-table-client .dash-cell {\n  white-space: nowrap !important;\n  overflow: hidden !important;\n  text-overflow: ellipsis !important;\n  height: 28px !important;\n  max-height: 28px !important;\n  line-height: 14px !important;\n}\n\n/* Allow containers to scroll and show all rows */\n#results-table .dash-spreadsheet-container, #results-table-client .dash-spreadsheet-container {\n  max-height: 600px !important;  /* Allow scrolling for all rows */\n  overflow: auto !important;\n}\n\n/* REMOVED: This was clipping the container to 28px, hiding all rows! */\n/*\n#results-table .dash-spreadsheet-inner, #results-table-client .dash-spreadsheet-inner {\n  max-height: 28px !important;\n}\n*/\n\n/* Make the table body rows have white background and black text while\n   keeping column headers unaffected. Use high-specificity selectors and\n   !important to override the dark theme for the results table rows. */\n#results-table .cell-table td, #results-table-client .cell-table td,\n#results-table .dash-spreadsheet-container .dash-spreadsheet-inner .cell, #results-table-client .dash-spreadsheet-container .dash-spreadsheet-inner .cell,\n#results-table .dash-cell, #results-table-client .dash-cell,\n#results-table .dash-cell-value, #results-table-client .dash-cell-value {\n  background-color: #ffffff !important;\n  color: #000000 !important;\n}\n\n/* Ensure the inner cell table uses the white background for full row width */\n/* Ensure the inner cell table uses the white background for full row width */\n#results-table .cell-table tbody tr td, #results-table-client .cell-table tbody tr td {\n  background-color: #ffffff !important;\n  color: #000000 !important;\n}\n"
