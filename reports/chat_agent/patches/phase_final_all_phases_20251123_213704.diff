++            "compression": 0,
++            "text": "/*\n * Chat Widget CSS - Force Black Text for Readability\n * Part of RAG Chat Assistant Implementation\n * Created: 2024-11-22\n */\n\n/* Force chat text color to black for all chat bubble and response containers */\n.chat-widget, \n.chat-container, \n.chat-response, \n.chat-bubble, \n.chat-message,\n#chatbot-messages-container,\n#chatbot-messages,\n#chatbot-input {\n  color: #000 !important;\n  /* Ensure background remains accessible; bubble background is light */\n  background-color: rgba(255,255,255,0.98) !important;\n}\n\n/* Specific targeting for message bubbles in the existing chatbot component */\n#chatbot-messages > div > div > div {\n  color: #333 !important;\n}\n\n/* User messages should have distinct styling but still readable text */\n.chat-message-user,\n#chatbot-messages .user-message {\n  color: #000 !important;\n  background-color: rgba(103, 126, 234, 0.15) !important;\n}\n\n/* Bot/assistant messages */\n.chat-message-bot,\n#chatbot-messages .bot-message {\n  color: #333 !important;\n  background-color: rgba(255,255,255,0.98) !important;\n}\n\n/* If your app uses theme classes like .theme-dark, still force readable text */\n.theme-dark .chat-widget, \n.theme-dark .chat-container, \n.theme-dark .chat-response, \n.theme-dark .chat-bubble, \n.theme-dark .chat-message,\n.theme-dark #chatbot-messages-container,\n.theme-dark #chatbot-messages {\n  color: #000 !important;\n  background-color: rgba(255,255,255,0.95) !important;\n}\n\n/* Input field must be readable */\n#chatbot-input {\n  color: #000 !important;\n  background-color: #fff !important;\n}\n\n#chatbot-input::placeholder {\n  color: #666 !important;\n  opacity: 0.7;\n}\n\n/* Action suggestion cards (for RAG action confirmations) */\n.chat-action-suggestion,\n[id^=\"chat-action-suggestion-\"] {\n  color: #000 !important;\n  background-color: #fff8e1 !important;\n  border: 2px solid #ffa726 !important;\n  padding: 12px;\n  margin: 8px 0;\n  border-radius: 8px;\n}\n\n.chat-action-suggestion .action-title {\n  font-weight: 600;\n  color: #000 !important;\n}\n\n.chat-action-suggestion .action-payload {\n  color: #333 !important;\n  font-size: 0.9em;\n  margin: 4px 0;\n}\n\n/* Confirmation buttons for actions */\n#chat-action-confirm-yes,\n#chat-action-confirm-no {\n  margin: 4px;\n}\n\n/* Source/provenance indicators */\n.chat-source-link,\n.chat-provenance {\n  color: #1976d2 !important;\n  font-size: 0.85em;\n  font-style: italic;\n}\n\n/* Data attribute for testing - color diagnostic */\n[data-testid=\"chat-color-diagnostic\"],\n#chat-color-diagnostic {\n  /* This element's computed color should be rgb(0, 0, 0) in tests */\n  color: #000 !important;\n  /* Make visible but non-intrusive for testing */\n  position: fixed;\n  bottom: 0;\n  right: 0;\n  width: 1px;\n  height: 1px;\n  opacity: 0.01;\n  pointer-events: none;\n  z-index: 999999;\n}\n\n/* Loading states */\n#chatbot-loading-output {\n  color: #000 !important;\n}\n\n/* Context toggle switch */\n#chat-toggle-context {\n  color: #000 !important;\n}\n\n/* Response containers with unique IDs (chat-response-<uuid>) */\n[id^=\"chat-response-\"] {\n  color: #333 !important;\n  background-color: #fff !important;\n  padding: 8px 12px;\n  margin: 6px 0;\n  border-radius: 8px;\n  border-left: 3px solid #667eea;\n}\n\n/* Ensure code blocks in chat remain readable */\n#chatbot-messages code,\n#chatbot-messages pre {\n  background-color: #f5f5f5 !important;\n  color: #000 !important;\n  border: 1px solid #ddd !important;\n  padding: 2px 6px;\n  border-radius: 4px;\n}\n\n#chatbot-messages pre code {\n  display: block;\n  padding: 8px;\n  overflow-x: auto;\n}\n"
