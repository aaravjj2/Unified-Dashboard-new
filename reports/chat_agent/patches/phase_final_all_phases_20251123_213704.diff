++            "text": "/* Market Forecast Table Styles - Clean white background with black text for readability */\n.dash-table-container {\n    background-color: #ffffff !important;\n}\n\n/* Force black text for the Market Forecast details (bootstrap tables rendered by dbc.Table)\n   and chain/forecast containers so white backgrounds keep readable black text. */\n#mf-details-table table,\n#mf-details-table th,\n#mf-details-table td,\n#mf-details-table .table,\n#mf-details-table .table th,\n#mf-details-table .table td,\n#chain-table-container table,\n#chain-table-container th,\n#chain-table-container td {\n    background-color: #ffffff !important;\n    color: #000000 !important;\n}\n\n#mf-details-table,\n#chain-table-container {\n    color: #000000 !important;\n}\n\n.dash-table-container .dash-spreadsheet {\n    background-color: #ffffff !important;\n}\n\n.dash-table-container .dash-spreadsheet-container {\n    background-color: #ffffff !important;\n    color: #000000 !important;\n}\n\n.dash-table-container td {\n    background-color: #ffffff !important;\n    color: #000000 !important;\n    border: 1px solid #ddd !important;\n    padding: 8px !important;\n}\n\n.dash-table-container th {\n    background-color: #f0f0f0 !important;\n    color: #000000 !important;\n    border: 1px solid #ddd !important;\n    font-weight: bold !important;\n    padding: 8px !important;\n}\n\n.dash-table-container .dash-spreadsheet tr:hover {\n    background-color: #f5f5f5 !important;\n}\n\n.dash-table-container .dash-cell {\n    color: #000000 !important;\n    background-color: #ffffff !important;\n}\n\n.dash-table-container .dash-cell-value {\n    color: #000000 !important;\n}\n\n/* Alternating row colors */\n.dash-table-container tbody tr:nth-child(odd) {\n    background-color: #f9f9f9 !important;\n}\n\n.dash-table-container tbody tr:nth-child(odd) td {\n    background-color: #f9f9f9 !important;\n}\n\n/* Ensure all text in DataTable is visible */\n.dash-table-container * {\n    color: #000000 !important;\n}\n\n.dash-table-container input {\n    background-color: #ffffff !important;\n    color: #000000 !important;\n    border: 1px solid #ddd !important;\n}\n"
