+"""
+Chat API Endpoints
+RESTful API for RAG chat assistant
+"""
+
+import os
+import logging
+import time
+import json
+from flask import Blueprint, request, jsonify
+from typing import Dict, Any
+
+from financial_dashboard.services.chat.generator_client import get_generator
+
+logger = logging.getLogger(__name__)
+
+# Create Blueprint
+chat_api = Blueprint('chat_api', __name__, url_prefix='/api/chat')
+
+
+@chat_api.route('/health', methods=['GET'])
+def health():
+    """
+    Check chat service health
+    
+    Returns generator status and vector index health
+    
+    GET /api/chat/health
+    
+    Response:
+        {
+            "status": "healthy" | "degraded" | "unhealthy",
+            "generator": {...},
+            "vector_index": {...},
+            "timestamp": "2024-11-22T10:30:00Z"
+        }
+    """
+    try:
+        # Check generator
+        generator = get_generator()
+        generator_health = generator.health_check()
+        
+        # Check vector index (placeholder for now)
+        index_health = {
+            "status": "not_implemented",
+            "size": 0,
+            "last_ingest": None
+        }
+        
+        # Determine overall status
+        if generator_health["status"] == "healthy":
+            overall_status = "healthy"
+        elif generator_health["status"] == "degraded":
+            overall_status = "degraded"
+        else:
+            overall_status = "unhealthy"
+        
+        return jsonify({
+            "status": overall_status,
+            "generator": generator_health,
+            "vector_index": index_health,
+            "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+        }), 200
+        
+    except Exception as e:
+        logger.error(f"Health check error: {e}", exc_info=True)
+        return jsonify({
+            "status": "unhealthy",
+            "error": str(e),
+            "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+        }), 500
+
+
+@chat_api.route('/query', methods=['POST'])
+def query():
+    """
+    Query the RAG chat assistant
+    
+    POST /api/chat/query
+    
+    Request body:
+        {
+            "query": "What is the volatility for AAPL?",
+            "use_rag": true,
+            "tab_context": {
+                "tab": "volatility_lab",
+                "ticker": "AAPL",
+                "data": {...}
+            },
+            "top_k": 8
+        }
+    
+    Response:
+        {
+            "answer": "Based on the retrieved data...",
+            "sources": [
+                {"chunk_id": "...", "text": "...", "score": 0.95},
+                ...
+            ],
+            "raw_model_text": "...",
+            "retrievals": [...],
+            "action_suggestion": {...} | null
+        }
+    """
+    try:
+        data = request.get_json()
+        
+        if not data or 'query' not in data:
+            return jsonify({"error": "Missing 'query' in request body"}), 400
+        
+        query_text = data['query']
+        use_rag = data.get('use_rag', True)
+        tab_context = data.get('tab_context', None)
+        top_k = data.get('top_k', 8)
+        
+        logger.info(f"Received query: {query_text[:100]}, use_rag={use_rag}")
+        
+        # For now, simple generator-only response (RAG implementation in PHASE 3)
+        generator = get_generator()
+        
+        # Build prompt with context
+        prompt = query_text
+        if tab_context:
+            prompt = f"Context: User is viewing {tab_context.get('tab', 'dashboard')}.\nQuery: {query_text}"
+        
+        response = generator.complete(prompt, max_tokens=512)
+        
+        # Check if response contains action suggestion (JSON format)
+        action_suggestion = None
+        try:
+            # Try to parse as JSON action
+            parsed = json.loads(response.text)
+            if 'action' in parsed:
+                action_suggestion = parsed
+        except json.JSONDecodeError:
+            pass
+        
+        return jsonify({
+            "answer": response.text if not action_suggestion else json.dumps(action_suggestion),
+            "sources": [],  # Populated in PHASE 3
+            "raw_model_text": response.text,
+            "retrievals": [],  # Populated in PHASE 3
+            "action_suggestion": action_suggestion,
+            "metadata": {
+                "model": response.model,
+                "tokens": response.total_tokens,
+                "use_rag": use_rag
+            }
+        }), 200
+        
+    except Exception as e:
+        logger.error(f"Query error: {e}", exc_info=True)
+        return jsonify({"error": str(e)}), 500
+
+
+@chat_api.route('/execute_action', methods=['POST'])
+def execute_action():
+    """
+    Execute a confirmed action
+    
+    POST /api/chat/execute_action
+    
+    Request body:
+        {
+            "action_id": "...",
+            "action_type": "create_paper_order",
+            "payload": {...},
+            "confirmed": true
+        }
+    
+    Response:
+        {
+            "success": true,
+            "result": {...},
+            "audit_id": "..."
+        }
+    """
+    try:
+        data = request.get_json()
+        
+        if not data or 'action_type' not in data:
+            return jsonify({"error": "Missing 'action_type' in request body"}), 400
+        
+        if not data.get('confirmed', False):
+            return jsonify({"error": "Action must be confirmed by user"}), 403
+        
+        action_type = data['action_type']
+        payload = data.get('payload', {})
+        
+        logger.info(f"Executing action: {action_type} with payload: {payload}")
+        
+        # Placeholder: Actual action execution in PHASE 4
+        # For now, just log and return success
+        
+        audit_id = f"audit_{int(time.time() * 1000)}"
+        
+        return jsonify({
+            "success": True,
+            "result": {
+                "action_type": action_type,
+                "payload": payload,
+                "status": "executed",
+                "note": "Action execution stub - full implementation in PHASE 4"
+            },
+            "audit_id": audit_id
+        }), 200
+        
+    except Exception as e:
+        logger.error(f"Action execution error: {e}", exc_info=True)
+        return jsonify({"error": str(e)}), 500
+
+
+@chat_api.route('/reindex', methods=['POST'])
+def reindex():
+    """
+    Trigger reindexing of vector index
+    
+    POST /api/chat/reindex
+    
+    Response:
+        {
+            "success": true,
+            "documents_indexed": 123,
+            "duration_ms": 4567
+        }
+    """
+    try:
+        # Placeholder for PHASE 2
+        logger.info("Reindex requested (not yet implemented)")
+        
+        return jsonify({
+            "success": True,
+            "documents_indexed": 0,
+            "duration_ms": 0,
+            "note": "Reindexing not yet implemented - coming in PHASE 2"
+        }), 200
+        
+    except Exception as e:
+        logger.error(f"Reindex error: {e}", exc_info=True)
+        return jsonify({"error": str(e)}), 500
+
+
+@chat_api.route('/ingest', methods=['POST'])
+def ingest():
+    """
+    Ingest documents into vector index
+    
+    POST /api/chat/ingest
+    
+    Request body:
+        {
+            "documents": [
+                {"text": "...", "metadata": {...}},
+                ...
+            ],
+            "use_fixtures": false
+        }
+    
+    Response:
+        {
+            "success": true,
+            "chunks_created": 234,
+            "indexed": 234
+        }
+    """
+    try:
+        data = request.get_json() or {}
+        
+        use_fixtures = data.get('use_fixtures', False)
+        documents = data.get('documents', [])
+        
+        logger.info(f"Ingest requested: {len(documents)} docs, fixtures={use_fixtures}")
+        
+        # Placeholder for PHASE 2
+        return jsonify({
+            "success": True,
+            "chunks_created": 0,
+            "indexed": 0,
+            "note": "Ingestion not yet implemented - coming in PHASE 2"
+        }), 200
+        
+    except Exception as e:
+        logger.error(f"Ingest error: {e}", exc_info=True)
+        return jsonify({"error": str(e)}), 500
+
+
+def register_chat_api(app):
+    """Register chat API blueprint with Flask app"""
+    app.register_blueprint(chat_api)
+    logger.info("Chat API registered at /api/chat/*")
