diff --git a/financial_dashboard/assets/chat.css b/financial_dashboard/assets/chat.css
new file mode 100644
index 0000000..b59af9d
--- /dev/null
+++ b/financial_dashboard/assets/chat.css
@@ -0,0 +1,87 @@
+/* 
+ * RAG Chat Assistant - Text Color Fix
+ * Ensures chat text is black and readable against light backgrounds
+ * Created for PHASE 0 of RAG Chat Assistant Implementation
+ */
+
+/* Force chat text color to black for all chat-related containers */
+#chatbot-container,
+#chatbot-window,
+#chatbot-messages-container,
+#chatbot-messages,
+.chat-widget,
+.chat-container,
+.chat-response,
+.chat-bubble,
+.chat-message {
+  color: #000 !important;
+  /* Ensure background remains accessible with light color */
+  background-color: rgba(255, 255, 255, 0.98) !important;
+}
+
+/* Specific targeting for message bubbles - AI responses */
+#chatbot-messages > div > div {
+  color: #333 !important;
+}
+
+/* User message bubbles should have white text on colored background */
+#chatbot-messages > div > div[style*="667eea"] {
+  color: #fff !important;
+  background-color: #667eea !important;
+}
+
+/* If theme classes exist, override them */
+.theme-dark #chatbot-container,
+.theme-dark #chatbot-window,
+.theme-dark #chatbot-messages-container,
+.theme-dark #chatbot-messages,
+.theme-dark .chat-widget,
+.theme-dark .chat-container,
+.theme-dark .chat-response,
+.theme-dark .chat-bubble,
+.theme-dark .chat-message {
+  color: #000 !important;
+  background-color: rgba(255, 255, 255, 0.95) !important;
+}
+
+/* Override for AI message bubbles specifically */
+.chat-message.ai-message,
+.chat-bubble.ai-message,
+div[style*="backgroundColor: white"] {
+  color: #333 !important;
+  background-color: white !important;
+}
+
+/* Ensure input text is also black */
+#chatbot-input,
+#chat-input {
+  color: #000 !important;
+}
+
+/* New RAG chat response containers */
+.chat-response-container {
+  color: #000 !important;
+  background-color: #fff !important;
+}
+
+/* Action suggestion cards */
+.chat-action-suggestion {
+  color: #000 !important;
+  background-color: #f8f9fa !important;
+  border: 1px solid #dee2e6;
+  border-radius: 8px;
+  padding: 12px;
+  margin: 8px 0;
+}
+
+/* Source/provenance display */
+.chat-sources {
+  color: #666 !important;
+  font-size: 12px;
+  font-style: italic;
+}
+
+/* Diagnostic attribute for Playwright color verification */
+[data-testid="chat-color"] {
+  /* This element will be checked by Playwright for computed color */
+}
