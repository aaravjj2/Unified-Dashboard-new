+                'borderRadius': '8px',
+                'padding': '20px',
+                'minWidth': '200px',
+                'flex': '1'
+            }),
+            
+            # Winners
+            html.Div([
+                html.H3("📈 Winners", style={'margin': '0 0 10px 0', 'color': '#2196F3', 'fontSize': '16px'}),
+                html.Div(str(summary['winners']), style={
+                    'fontSize': '24px',
