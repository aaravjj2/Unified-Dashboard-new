+++@admin_bp.route('/admin/tab_health/<tab>')
+++def tab_health(tab):
+++    repo_root = os.path.abspath(os.path.join(os.path.dirname(__file__), '..'))
+++    diag_dir = os.path.join(repo_root, 'reports', 'agent2a')
+++    report = os.path.join(diag_dir, 'architecture_report.json')
