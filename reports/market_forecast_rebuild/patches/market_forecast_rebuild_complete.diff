+                    title=trend_tooltip,
+                    style={
+                        'backgroundColor': badge_color,
+                        'color': 'white',
+                        'padding': '6px 16px',
+                        'borderRadius': '6px',
+                        'fontSize': '15px',
+                        'fontWeight': 'bold',
+                        'display': 'inline-block',
+                        'marginBottom': '12px',
+                        'cursor': 'help',
+                        'boxShadow': '0 2px 4px rgba(0,0,0,0.2)',
+                    }
+                )
+            ])
+        
+        return html.Div([
+            html.H5("Compact Brief"),
+            trend_badge,  # Display badge ABOVE the text
+            html.P(truncated)
+        ])
+
+    app.clientside_callback(
+        """
+        function(n_clicks, text) {
+            if (n_clicks > 0 && text) {
+                fetch('/log-message', {
