+++    # best-effort health: presence in major_tabs
+++    major = data.get('major_tabs', {})
+++    if tab not in major:
+++        return jsonify({'ok': False, 'msg': 'Tab not found in report'})
+++    return jsonify({'ok': True, 'tab': tab, 'files': major.get(tab)})
