+        ]
+        
+        table = dash_table.DataTable(
+            data=formatted_df.to_dict('records'),
+            columns=columns,
+            style_table={
+                'overflowX': 'auto',
+                'marginTop': '20px'
+            },
+            style_cell={
+                'textAlign': 'left',
+                'padding': '8px',
