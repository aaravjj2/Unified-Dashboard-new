+        if error:
+            return html.Div(error, style={'color': '#ff6b6b', 'padding': '20px'}), None
+        
+        if df is None:
+            return html.Div("No data available", style={'color': '#888'}), None
+        
+        # Parse values for conditional styling
+        try:
