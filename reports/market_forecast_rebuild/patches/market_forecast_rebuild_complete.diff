+#!/usr/bin/env python3
+"""
+Check browser console for JavaScript errors.
+"""
+
+from playwright.sync_api import sync_playwright
+import time
+
+with sync_playwright() as p:
+    browser = p.chromium.launch(headless=False, slow_mo=300)
+    page = browser.new_page()
+    
+    js_errors = []
+    def handle_console(msg):
+        if msg.type == 'error':
+            js_errors.append(msg.text)
+            print(f"❌ JS ERROR: {msg.text[:150]}")
+    
+    page.on("console", handle_console)
+    page.on("pageerror", lambda exc: print(f"❌ PAGE ERROR: {exc}"))
+    
+    page.goto("http://localhost:8051/", timeout=30000)
+    time.sleep(3)
+    
+    print("\nClicking Portfolio tab...")
+    page.click('a[role="tab"]:has-text("Portfolio")')
+    time.sleep(2)
+    
+    print("Clicking refresh button...")
+    page.click('#portfolio-refresh-btn')
+    time.sleep(3)
+    
+    print(f"\n{'='*60}")
+    print(f"Total JavaScript errors: {len(js_errors)}")
+    print(f"{'='*60}")
+    
+    time.sleep(2)
+    browser.close()
