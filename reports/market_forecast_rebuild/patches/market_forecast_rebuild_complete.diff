+            # Losers
+            html.Div([
+                html.H3("📉 Losers", style={'margin': '0 0 10px 0', 'color': '#2196F3', 'fontSize': '16px'}),
+                html.Div(str(summary['losers']), style={
+                    'fontSize': '24px',
+                    'fontWeight': 'bold',
+                    'margin': '5px 0',
