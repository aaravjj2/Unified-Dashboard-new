+"""
+ResearchStore abstraction - persistence layer for research briefs.
+
+Provides two implementations:
+- JSONStore: Local JSON file storage with atomic writes and thread-safety
+- DBStore: SQLAlchemy-based database storage (optional)
+"""
+
+import os
+import json
+import logging
+import fcntl
+import threading
+import tempfile
+from datetime import datetime
+from typing import List, Dict, Optional
+from pathlib import Path
+from abc import ABC, abstractmethod
+
+logger = logging.getLogger(__name__)
+
+# Configure diagnostic logging
+DIAGNOSTICS_DIR = Path("reports/research_lab_fix/diagnostics")
+DIAGNOSTICS_DIR.mkdir(parents=True, exist_ok=True)
+STORE_OPS_LOG = DIAGNOSTICS_DIR / "store_ops.log"
+
+# File handler for store operations
+store_logger = logging.getLogger("research.store")
+store_fh = logging.FileHandler(STORE_OPS_LOG)
+store_fh.setFormatter(logging.Formatter(
+    '%(asctime)s - %(name)s - %(levelname)s - %(message)s'
+))
+store_logger.addHandler(store_fh)
+store_logger.setLevel(logging.DEBUG)
+
+
+class ResearchStore(ABC):
+    """
+    Abstract base class for research brief storage.
+    
+    Defines the interface for CRUD operations on research briefs.
+    Implementations must provide thread-safe, atomic operations.
+    """
+    
+    @abstractmethod
+    def list_briefs(self) -> List[Dict]:
+        """
+        Retrieve all research briefs.
+        
+        Returns:
+            List of brief dictionaries with keys: id, title, created, updated, etc.
+        """
+        pass
+    
+    @abstractmethod
+    def get_brief(self, brief_id: str) -> Optional[Dict]:
+        """
+        Retrieve a specific research brief by ID.
+        
+        Args:
+            brief_id: Unique identifier for the brief
+            
+        Returns:
+            Brief dictionary or None if not found
+        """
+        pass
+    
+    @abstractmethod
+    def create_brief(self, brief_obj: Dict) -> Dict:
+        """
+        Create a new research brief.
+        
+        Args:
+            brief_obj: Dictionary containing brief data (title, tags, summary, body, etc.)
+            
+        Returns:
+            Created brief with generated ID and timestamps
+        """
+        pass
+    
+    @abstractmethod
+    def update_brief(self, brief_id: str, patch: Dict) -> Optional[Dict]:
+        """
+        Update an existing research brief.
+        
+        Args:
+            brief_id: Unique identifier for the brief
+            patch: Dictionary of fields to update
+            
+        Returns:
+            Updated brief or None if not found
+        """
+        pass
+    
+    @abstractmethod
+    def delete_brief(self, brief_id: str) -> bool:
+        """
+        Delete a research brief.
+        
+        Args:
+            brief_id: Unique identifier for the brief
+            
+        Returns:
+            True if deleted, False if not found
+        """
+        pass
+    
+    @abstractmethod
+    def export_brief(self, brief_id: str) -> Optional[str]:
+        """
+        Export a research brief as JSON string.
+        
+        Args:
+            brief_id: Unique identifier for the brief
+            
+        Returns:
+            JSON string representation of the brief, or None if not found
+        """
+        pass
+    
+    @abstractmethod
+    def get_metadata(self) -> Dict:
+        """
+        Retrieve storage metadata.
+        
+        Returns:
+            Dictionary containing count, last_modified, store_type, etc.
+        """
+        pass
+
+
+class JSONStore(ResearchStore):
+    """
+    JSON file-based storage for research briefs.
+    
+    Features:
+    - Atomic writes using temp file + os.replace()
+    - Thread-safe operations using RLock
+    - In-memory cache with TTL
+    - File locking for concurrent process safety
+    """
+    
+    def __init__(self, path: str = 'data/research/briefs.json'):
+        """
+        Initialize JSON store.
+        
+        Args:
+            path: Path to JSON file for storage
+        """
+        self.path = Path(path)
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        self._lock = threading.RLock()
+        self._cache: Optional[Dict] = None
+        self._cache_loaded_at: Optional[datetime] = None
+        self._cache_ttl_seconds = 5  # Short TTL for consistency
+        
+        # Initialize empty file if doesn't exist
+        if not self.path.exists():
+            self._write_data({'briefs': [], 'metadata': {'created': datetime.utcnow().isoformat()}})
+        
+        store_logger.info(f"JSONStore initialized at {self.path}")
+    
+    def _read_data(self) -> Dict:
+        """
+        Read data from JSON file with file locking.
+        
+        Returns:
+            Dictionary containing 'briefs' and 'metadata'
+        """
+        with self._lock:
+            # Check cache freshness
+            if self._cache and self._cache_loaded_at:
+                age = (datetime.utcnow() - self._cache_loaded_at).total_seconds()
+                if age < self._cache_ttl_seconds:
+                    store_logger.debug(f"Cache hit (age: {age:.2f}s)")
+                    return self._cache
+            
+            # Read from file
+            try:
+                with open(self.path, 'r') as f:
+                    fcntl.flock(f.fileno(), fcntl.LOCK_SH)
+                    try:
+                        data = json.load(f)
+                        # Ensure structure
+                        if 'briefs' not in data:
+                            data['briefs'] = []
+                        if 'metadata' not in data:
+                            data['metadata'] = {}
+                        
+                        self._cache = data
+                        self._cache_loaded_at = datetime.utcnow()
+                        store_logger.debug(f"Loaded {len(data['briefs'])} briefs from disk")
+                        return data
+                    finally:
+                        fcntl.flock(f.fileno(), fcntl.LOCK_UN)
+            except Exception as e:
+                store_logger.error(f"Error reading data: {e}")
+                return {'briefs': [], 'metadata': {}}
+    
+    def _write_data(self, data: Dict):
+        """
+        Write data to JSON file atomically using temp file.
+        
+        Args:
+            data: Dictionary containing 'briefs' and 'metadata'
+        """
+        with self._lock:
+            try:
+                # Write to temp file
+                fd, temp_path = tempfile.mkstemp(
+                    dir=self.path.parent,
+                    prefix='.briefs_tmp_',
+                    suffix='.json'
+                )
+                
+                with os.fdopen(fd, 'w') as f:
+                    json.dump(data, f, indent=2, default=str)
+                    f.flush()
+                    os.fsync(f.fileno())
+                
+                # Atomic replace
+                os.replace(temp_path, self.path)
+                
+                # Update cache
+                self._cache = data
+                self._cache_loaded_at = datetime.utcnow()
+                
+                store_logger.debug(f"Wrote {len(data['briefs'])} briefs to disk atomically")
+            except Exception as e:
+                store_logger.error(f"Error writing data: {e}")
+                # Clean up temp file if exists
+                if 'temp_path' in locals() and Path(temp_path).exists():
+                    Path(temp_path).unlink()
+                raise
+    
+    def force_reload(self):
+        """Force reload from disk, bypassing cache."""
+        with self._lock:
+            self._cache = None
+            self._cache_loaded_at = None
+            store_logger.info("Cache cleared, forcing reload")
+    
+    def list_briefs(self) -> List[Dict]:
+        """List all research briefs."""
+        data = self._read_data()
+        store_logger.info(f"list_briefs: returning {len(data['briefs'])} briefs")
+        return data['briefs']
+    
+    def get_brief(self, brief_id: str) -> Optional[Dict]:
+        """Retrieve a specific research brief by ID."""
+        data = self._read_data()
+        for brief in data['briefs']:
+            if brief.get('id') == brief_id:
+                store_logger.info(f"get_brief: found brief {brief_id}")
+                return brief
+        store_logger.warning(f"get_brief: brief {brief_id} not found")
+        return None
+    
+    def create_brief(self, brief_obj: Dict) -> Dict:
+        """Create a new research brief."""
+        import uuid
+        
+        data = self._read_data()
+        
+        # Generate ID and timestamps
+        new_brief = brief_obj.copy()
+        new_brief['id'] = str(uuid.uuid4())
+        new_brief['created'] = datetime.utcnow().isoformat()
+        new_brief['updated'] = datetime.utcnow().isoformat()
+        
+        # Add to list
+        data['briefs'].append(new_brief)
+        data['metadata']['last_modified'] = datetime.utcnow().isoformat()
+        
+        self._write_data(data)
+        store_logger.info(f"create_brief: created brief {new_brief['id']}")
+        return new_brief
+    
+    def update_brief(self, brief_id: str, patch: Dict) -> Optional[Dict]:
+        """Update an existing research brief."""
+        data = self._read_data()
+        
+        for i, brief in enumerate(data['briefs']):
+            if brief.get('id') == brief_id:
+                # Apply patch
+                for key, value in patch.items():
+                    if key not in ['id', 'created']:  # Don't allow changing immutable fields
+                        brief[key] = value
+                
+                brief['updated'] = datetime.utcnow().isoformat()
+                data['metadata']['last_modified'] = datetime.utcnow().isoformat()
+                
+                self._write_data(data)
+                store_logger.info(f"update_brief: updated brief {brief_id}")
+                return brief
+        
+        store_logger.warning(f"update_brief: brief {brief_id} not found")
+        return None
+    
+    def delete_brief(self, brief_id: str) -> bool:
+        """Delete a research brief."""
+        data = self._read_data()
+        
+        initial_count = len(data['briefs'])
+        data['briefs'] = [b for b in data['briefs'] if b.get('id') != brief_id]
+        
+        if len(data['briefs']) < initial_count:
+            data['metadata']['last_modified'] = datetime.utcnow().isoformat()
+            self._write_data(data)
+            store_logger.info(f"delete_brief: deleted brief {brief_id}")
+            return True
+        
+        store_logger.warning(f"delete_brief: brief {brief_id} not found")
+        return False
+    
+    def export_brief(self, brief_id: str) -> Optional[str]:
+        """Export a research brief as JSON string."""
+        brief = self.get_brief(brief_id)
+        if brief:
+            store_logger.info(f"export_brief: exporting brief {brief_id}")
+            return json.dumps(brief, indent=2, default=str)
+        return None
+    
+    def get_metadata(self) -> Dict:
+        """Retrieve storage metadata."""
+        data = self._read_data()
+        metadata = data.get('metadata', {}).copy()
+        metadata['brief_count'] = len(data['briefs'])
+        metadata['store_type'] = 'json'
+        metadata['path'] = str(self.path)
+        store_logger.debug(f"get_metadata: {metadata}")
+        return metadata
+
+
+class DBStore(ResearchStore):
+    """
+    SQLAlchemy-based database storage for research briefs.
+    
+    This is an optional implementation that requires:
+    - SQLAlchemy installed
+    - Database configured via env vars
+    - RESEARCH_DB_ENABLED=true
+    
+    Not implemented in this initial version - use JSONStore as default.
+    """
+    
+    def __init__(self, connection_string: Optional[str] = None):
+        raise NotImplementedError(
+            "DBStore is not yet implemented. Use JSONStore for local persistence."
+        )
+    
+    def list_briefs(self) -> List[Dict]:
+        raise NotImplementedError
+    
+    def get_brief(self, brief_id: str) -> Optional[Dict]:
+        raise NotImplementedError
+    
+    def create_brief(self, brief_obj: Dict) -> Dict:
+        raise NotImplementedError
+    
+    def update_brief(self, brief_id: str, patch: Dict) -> Optional[Dict]:
+        raise NotImplementedError
+    
+    def delete_brief(self, brief_id: str) -> bool:
+        raise NotImplementedError
+    
+    def export_brief(self, brief_id: str) -> Optional[str]:
+        raise NotImplementedError
+    
+    def get_metadata(self) -> Dict:
+        raise NotImplementedError
