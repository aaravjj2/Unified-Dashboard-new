++# SUBTAB 4: STRATEGY BACKTEST CALLBACKS
++# ============================================================================
++
++@callback(
++    Output('backtest-results-container', 'children'),
++    Input('backtest-run-button', 'n_clicks'),
++    State('backtest-portfolio', 'value'),
++    State('backtest-date-range', 'start_date'),
++    State('backtest-date-range', 'end_date'),
++    State('backtest-rebalance-freq', 'value'),
++    prevent_initial_call=True
++)
++def run_backtest(n_clicks, portfolio_str, start_date, end_date, rebalance_freq):
++    """Run simple portfolio backtest."""
++    if not n_clicks or not portfolio_str:
++        return html.Div("Enter portfolio and click 'Run Backtest'", className='text-muted')
++    
++    try:
++        # Parse portfolio: "SPY:0.6,QQQ:0.4"
++        portfolio_items = portfolio_str.split(',')
++        weights = {}
++        tickers = []
++        
++        for item in portfolio_items:
++            ticker, weight = item.split(':')
++            ticker = ticker.strip().upper()
++            weight = float(weight.strip())
++            weights[ticker] = weight
++            tickers.append(ticker)
++        
++        logger.info(f"⚙️ Backtest: {weights}")
++        
++        # Fetch price data
++        price_data = data_loader.fetch_price_data(tickers, start_date, end_date)
++        
++        # Simulate returns
++        portfolio_returns = data_loader.simulate_portfolio_returns(
++            price_data, weights, rebalance_freq
++        )
++        
++        if portfolio_returns.empty:
++            return html.Div("❌ No data available", className='text-danger')
++        
++        # Calculate metrics
++        metrics = data_loader.calculate_performance_metrics(portfolio_returns)
++        
++        # Create cumulative return chart
++        cumulative = (1 + portfolio_returns).cumprod()
++        
++        fig = go.Figure()
++        fig.add_trace(go.Scatter(
++            x=cumulative.index,
++            y=cumulative.values,
++            mode='lines',
++            name='Portfolio Value',
++            line={'color': 'lightgreen', 'width': 2}
++        ))
++        
++        fig.update_layout(
++            title="Portfolio Cumulative Returns",
++            xaxis_title="Date",
++            yaxis_title="Cumulative Return",
++            template='plotly_dark',
++            paper_bgcolor='#1e1e1e',
++            plot_bgcolor='#2d2d2d',
++            height=400
++        )
++        
++        # Metrics display
++        metrics_div = html.Div([
++            html.H6("📊 Performance Metrics", className='text-white mb-3'),
++            html.P(f"Cumulative Return: {metrics['cumulative_return']*100:.2f}%", className='text-success'),
++            html.P(f"Annual Return: {metrics['annual_return']*100:.2f}%", className='text-info'),
++            html.P(f"Annual Volatility: {metrics['annual_volatility']*100:.2f}%", className='text-warning'),
++            html.P(f"Sharpe Ratio: {metrics['sharpe_ratio']:.2f}", className='text-primary'),
++            html.P(f"Max Drawdown: {metrics['max_drawdown']*100:.2f}%", className='text-danger'),
++        ])
++        
++        return html.Div([
++            metrics_div,
++            dcc.Graph(figure=fig)
++        ])
++        
++    except Exception as e:
++        logger.error(f"❌ Backtest error: {e}")
++        return html.Div(f"❌ Error: {str(e)}", className='text-danger')
++
