++def run_factor_analysis(n_clicks, ticker, start_date, end_date, model):
++    """Calculate factor exposures."""
++    if not n_clicks or not ticker:
++        return html.Div("Enter ticker and click 'Calculate Exposures'", className='text-muted')
++    
++    try:
++        logger.info(f"📊 Factor analysis: {ticker} ({model})")
++        
++        # Fetch price data
++        price_data = data_loader.fetch_price_data([ticker], start_date, end_date)
++        if ticker not in price_data or price_data[ticker].empty:
++            return html.Div(f"❌ No data for {ticker}", className='text-danger')
++        
++        # Calculate returns
++        returns = price_data[ticker]['Close'].pct_change().dropna()
++        
++        # Load factor data
++        factors = data_loader.load_fama_french_factors(start_date, end_date)
++        
++        # Select factors based on model
++        if model == 'ff3':
++            factor_cols = ['Mkt-RF', 'SMB', 'HML']
++        elif model == 'ff5':
++            factor_cols = ['Mkt-RF', 'SMB', 'HML', 'RMW', 'CMA']
++        else:  # CAPM
++            factor_cols = ['Mkt-RF']
++        
++        factors_subset = factors[factor_cols]
++        
++        # Calculate exposures
++        exposures = data_loader.calculate_factor_exposures(returns, factors_subset)
++        
++        if 'error' in exposures:
++            return html.Div(f"❌ {exposures['error']}", className='text-danger')
++        
++        # Format results
++        results_list = []
++        results_list.append(html.H6(f"📊 {ticker} Factor Exposures", className='text-white mb-3'))
++        results_list.append(html.P(f"Alpha: {exposures['alpha']:.4f}", className='text-info'))
++        results_list.append(html.P(f"R²: {exposures['r_squared']:.4f}", className='text-info'))
++        
++        for key, value in exposures.items():
++            if key.startswith('beta_'):
++                factor_name = key.replace('beta_', '')
++                results_list.append(html.P(f"{factor_name}: {value:.4f}", className='text-success'))
++        
++        # Create bar chart
++        beta_keys = [k for k in exposures.keys() if k.startswith('beta_')]
++        beta_values = [exposures[k] for k in beta_keys]
++        beta_labels = [k.replace('beta_', '') for k in beta_keys]
++        
++        fig = go.Figure(data=[
++            go.Bar(x=beta_labels, y=beta_values, marker_color='lightblue')
++        ])
++        fig.update_layout(
++            title=f"{ticker} Factor Loadings",
++            xaxis_title="Factor",
++            yaxis_title="Beta",
++            template='plotly_dark',
++            paper_bgcolor='#1e1e1e',
++            plot_bgcolor='#2d2d2d'
++        )
++        
++        results_list.append(dcc.Graph(figure=fig))
++        
++        return html.Div(results_list)
++        
++    except Exception as e:
++        logger.error(f"❌ Factor analysis error: {e}")
++        return html.Div(f"❌ Error: {str(e)}", className='text-danger')
++
++
