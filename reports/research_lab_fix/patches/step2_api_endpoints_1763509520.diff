++    prevent_initial_call=True
++)
++def calculate_correlation(n_clicks, tickers_str, start_date, end_date, method):
++    """Calculate and visualize correlation matrix."""
++    if not n_clicks or not tickers_str:
++        # Return empty figure
++        return go.Figure().update_layout(template='plotly_dark')
++    
++    try:
++        # Parse tickers
++        tickers = [t.strip().upper() for t in tickers_str.split(',')]
++        logger.info(f"🔗 Correlation: {tickers} ({method})")
++        
++        # Fetch price data
++        price_data = data_loader.fetch_price_data(tickers, start_date, end_date)
++        
++        # Calculate correlation
++        corr_matrix = data_loader.calculate_correlation_matrix(price_data, method=method)
++        
++        if corr_matrix.empty:
++            fig = go.Figure()
++            fig.add_annotation(
++                text="❌ No data available",
++                xref="paper", yref="paper",
++                x=0.5, y=0.5, showarrow=False,
++                font={'size': 20, 'color': 'red'}
++            )
++            fig.update_layout(template='plotly_dark')
++            return fig
++        
++        # Create heatmap
++        fig = px.imshow(
++            corr_matrix,
++            labels=dict(color="Correlation"),
++            x=corr_matrix.columns,
++            y=corr_matrix.index,
++            color_continuous_scale='RdBu_r',
++            zmin=-1, zmax=1,
++            text_auto='.2f'
++        )
++        
++        fig.update_layout(
++            title=f"Correlation Matrix ({method.capitalize()})",
++            template='plotly_dark',
++            paper_bgcolor='#1e1e1e',
++            plot_bgcolor='#2d2d2d',
++            xaxis={'side': 'bottom'},
++            height=600
++        )
++        
++        return fig
++        
++    except Exception as e:
++        logger.error(f"❌ Correlation error: {e}")
++        fig = go.Figure()
++        fig.add_annotation(
++            text=f"❌ Error: {str(e)}",
++            xref="paper", yref="paper",
++            x=0.5, y=0.5, showarrow=False,
++            font={'size': 16, 'color': 'red'}
++        )
++        fig.update_layout(template='plotly_dark')
++        return fig
++
++
