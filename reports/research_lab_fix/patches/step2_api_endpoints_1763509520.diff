++def run_market_scan(n_clicks, tickers_str, market_cap_range, sectors, pe_range, beta_range):
++    """Run market screening with filters."""
++    if not n_clicks or not tickers_str:
++        return html.Div("Enter tickers and click 'Run Screen'", className='text-muted')
++    
++    try:
++        # Parse tickers
++        tickers = [t.strip().upper() for t in tickers_str.split(',')]
++        logger.info(f"🔍 Market scan: {tickers}")
++        
++        # Fetch ticker info
++        ticker_info = data_loader.fetch_ticker_info(tickers)
++        
++        # Apply filters
++        filtered = data_loader.apply_market_filters(
++            ticker_info,
++            min_market_cap=market_cap_range[0] * 1e9,
++            max_market_cap=market_cap_range[1] * 1e9,
++            sectors=sectors if sectors else None,
++            min_pe=pe_range[0] if pe_range else None,
++            max_pe=pe_range[1] if pe_range else None,
++            min_beta=beta_range[0] if beta_range else None,
++            max_beta=beta_range[1] if beta_range else None
++        )
++        
++        if filtered.empty:
++            return html.Div("❌ No tickers passed the filters", className='text-warning')
++        
++        # Format for display
++        display_df = filtered.copy()
++        display_df['market_cap'] = display_df['market_cap'].apply(lambda x: f"${x/1e9:.2f}B")
++        display_df['pe_ratio'] = display_df['pe_ratio'].apply(lambda x: f"{x:.2f}" if pd.notna(x) else 'N/A')
++        display_df['beta'] = display_df['beta'].apply(lambda x: f"{x:.2f}" if pd.notna(x) else 'N/A')
++        display_df['dividend_yield'] = display_df['dividend_yield'].apply(lambda x: f"{x*100:.2f}%" if pd.notna(x) else '0.00%')
++        
++        # Create table
++        table = dash_table.DataTable(
++            data=display_df.to_dict('records'),
++            columns=[
++                {'name': 'Ticker', 'id': 'ticker'},
++                {'name': 'Name', 'id': 'name'},
++                {'name': 'Sector', 'id': 'sector'},
++                {'name': 'Market Cap', 'id': 'market_cap'},
++                {'name': 'P/E Ratio', 'id': 'pe_ratio'},
++                {'name': 'Beta', 'id': 'beta'},
++                {'name': 'Div Yield', 'id': 'dividend_yield'},
++            ],
++            style_table={'overflowX': 'auto'},
++            style_header={
++                'backgroundColor': '#343a40',
++                'color': 'white',
++                'fontWeight': 'bold',
++                'textAlign': 'center'
++            },
++            style_cell={
++                'backgroundColor': '#ffffff',
++                'color': '#000000',
++                'textAlign': 'left',
++                'padding': '10px'
++            },
++            style_data_conditional=[
++                {
++                    'if': {'row_index': 'odd'},
++                    'backgroundColor': '#f8f9fa'
++                }
++            ]
++        )
++        
++        summary = html.Div([
++            html.P(f"✅ {len(filtered)} / {len(ticker_info)} tickers passed filters", className='text-success mb-2'),
++            table
++        ])
++        
++        return summary
++        
++    except Exception as e:
++        logger.error(f"❌ Market scan error: {e}")
++        return html.Div(f"❌ Error: {str(e)}", className='text-danger')
