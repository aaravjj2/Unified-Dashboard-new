+++def _safe_float(val) -> float:
+++    """Convert a value or array-like to a single float safely.
+++
+++    - If `val` is already scalar convert directly.
+++    - If `val` is array-like, return the first element as float (fallback).
+++    - Empty arrays return 0.0.
+++    """
+++    try:
+++        return float(val)
+++    except (TypeError, ValueError):
+++        arr = np.asarray(val)
+++        if arr.size == 0:
+++            return 0.0
+++        return float(arr.flat[0])
+++
