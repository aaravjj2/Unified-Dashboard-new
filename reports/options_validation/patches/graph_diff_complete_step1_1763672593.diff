+++                                                                                },
+++                                                                                {
+++                                                                                    "props": {
+++                                                                                        "children": "Comprehensive portfolio attribution: performance, factors, sectors, and alpha generation",
+++                                                                                        "className": "mb-3",
+++                                                                                        "style": {
+++                                                                                            "color": "#000000"
+++                                                                                        }
