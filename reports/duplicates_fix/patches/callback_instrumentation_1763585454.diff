+            "text": "/* Portfolio Tracker specific fixes */\n\n/* Force black text in all card bodies (portfolio summary cards) */\n.card-body h3, .card-body h6, .card-body h4, .card-body h5 {\n    color: #000000 !important;\n}\n\n/* Specifically target portfolio value cards */\n#portfolio-value, #portfolio-invested, #portfolio-unrealized-pl, #portfolio-buying-power {\n    color: #000000 !important;\n}\n\n/* Target the muted text labels in cards */\n.card-body .text-muted {\n    color: #6c757d !important;\n}\n\n/* Analytics metrics cards */\n#portfolio-var, #portfolio-cvar, #portfolio-sharpe, #portfolio-beta {\n    color: #000000 !important;\n}\n\n/* Ensure DataTable text is black */\n.dash-table-container {\n    color: #000000 !important;\n}\n\n.dash-table-container .dash-cell {\n    color: #000000 !important;\n}\n\n/* Plotly charts text should be black */\n.js-plotly-plot .plotly text {\n    fill: #000000 !important;\n}\n"
