+            "text": "/* Force visibility for all Dash tabs - Phase 4 Fix */\n\n/* Make sure main dashboard tabs container is visible (scoped) */\n#dashboard-tabs, #dashboard-tabs[role=\"tablist\"] {\n    display: flex !important;\n    visibility: visible !important;\n    opacity: 1 !important;\n    height: auto !important;\n    min-height: 40px !important;\n}\n\n/* Make individual top-level dashboard tab buttons visible (direct children only) */\n#dashboard-tabs > .nav-item > .nav-link,\n#dashboard-tabs > li > .nav-link,\n#dashboard-tabs > .nav-link {\n    display: inline-block !important;\n    visibility: visible !important;\n    opacity: 1 !important;\n    padding: 10px 20px !important;\n    margin-right: 5px !important;\n    background-color: #2b3035 !important;\n    color: #adb5bd !important;\n    border: 1px solid #3a3f44 !important;\n    border-radius: 4px 4px 0 0 !important;\n}\n\n/* Active tab styling */\n.nav-tabs .nav-link.active, [role=\"tab\"][aria-selected=\"true\"] {\n    background-color: #00bc8c !important;\n    color: #ffffff !important;\n    border-bottom-color: transparent !important;\n}\n\n/* Tab content must be visible for the main dashboard panes only */\n/* Avoid forcing all .tab-content globally which exposes nested subtabs */\n#dashboard-tabs + .tab-content, #dashboard-tabs ~ .tab-content {\n    display: block !important;\n    visibility: visible !important;\n    opacity: 1 !important;\n    min-height: 400px !important;\n    padding: 20px !important;\n}\n\n/* Hidden tab panels */\n.tab-content > .tab-pane:not(.active) {\n    display: none !important;\n}\n\n.tab-content > .tab-pane.active,\n.tab-content > [role=\"tabpanel\"][aria-hidden=\"false\"] {\n    display: block !important;\n}\n\n/* Container visibility */\n.container, .container-fluid {\n    display: block !important;\n    visibility: visible !important;\n    opacity: 1 !important;\n}\n\n/* Card visibility */\n.card {\n    display: block !important;\n    visibility: visible !important;\n    opacity: 1 !important;\n    background-color: #2b3035 !important;\n    border: 1px solid #3a3f44 !important;\n}\n\n/* Ensure all text is visible */\nh1, h2, h3, h4, h5, h6, p, div, span, label {\n    color: #ffffff !important;\n    visibility: visible !important;\n}\n\n.text-muted {\n    color: #adb5bd !important;\n}\n\n/* DataTable visibility */\n.dash-table-container {\n    display: block !important;\n    visibility: visible !important;\n}\n\n/* Graph visibility */\n.js-plotly-plot {\n    display: block !important;\n    visibility: visible !important;\n}\n"
