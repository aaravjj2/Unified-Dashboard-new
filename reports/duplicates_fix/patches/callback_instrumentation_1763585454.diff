  }, 1000);\n    \n    // Stop retrying after 30 seconds\n    setTimeout(function() {\n        clearInterval(checkInterval);\n    }, 30000);\n    \n    console.log('[Tab Fix] Portfolio tab label injector loaded');\n})();\n"
