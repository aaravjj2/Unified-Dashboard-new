+            "text": "/* Override problematic row-clamping rules and ensure table rows are visible in Market Trends */\n/* Use very high specificity to beat earlier selectors */\n#trends-results-table-container, #trends-results-table-container * ,\n#results-table, #results-table * , #results-table-client, #results-table-client * {\n  background-color: transparent !important;\n  color: inherit !important;\n  opacity: 1 !important;\n}\n\n/* Force table cells to be visible with proper styling */\n/* CRITICAL: DO NOT override display property - it breaks DataTable virtualization */\n/* CRITICAL: DO NOT override height/max-height - let market_trends_table.css control sizing */\n#trends-results-table-container td, #trends-results-table-container .dash-cell, #trends-results-table-container .dash-cell-value,\n#results-table td, #results-table .dash-cell, #results-table .dash-cell-value,\n#results-table-client td, #results-table-client .dash-cell, #results-table-client .dash-cell-value {\n  /* height: auto !important; */        /* REMOVED: Conflicts with 28px compact height */\n  /* max-height: none !important; */    /* REMOVED: Conflicts with 28px compact height */\n  /* line-height: normal !important; */ /* REMOVED: Let market_trends_table.css control */\n  /* white-space: normal !important; */ /* REMOVED: Let market_trends_table.css control */\n  /* overflow: visible !important; */   /* REMOVED: Let market_trends_table.css control */\n  /* display: table-cell !important; */ /* REMOVED: Causes handleResize infinite recursion */\n  color: #000000 !important;\n  background-color: #ffffff !important;\n  opacity: 1 !important;\n}\n\n/* Ensure the inner spreadsheet/virtual rows are not display:block which collapses layout */\n/* REMOVED: display override causes crashes */\n/*\n#results-table .dash-spreadsheet-inner div.cell, #results-table-client .dash-spreadsheet-inner div.cell,\n#trends-results-table-container .dash-spreadsheet-inner div.cell {\n  display: table-cell !importa