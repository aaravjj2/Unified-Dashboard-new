+
+sys.path.insert(0, os.getcwd())
+
+# Silence noisy logs so output stays valid JSON
+logging.basicConfig(level=logging.ERROR)
+
+out = {}
+try:
+    from financial_dashboard.app import create_app
+    app = create_app()
+    callback_map = getattr(app, "callback_map", {})
