{
  "pipeline_metadata": {
    "name": "Unified Financial Dashboard CI/CD Pipeline",
    "version": "1.0.0",
    "created": "2025-01-30T00:00:00Z",
    "purpose": "Automated testing, building, and deployment to Azure",
    "status": "Ready for execution (awaiting Azure credentials)"
  },
  "workflows": {
    "continuous_integration": {
      "file": ".github/workflows/ci.yml",
      "trigger": ["push", "pull_request"],
      "jobs": {
        "lint-and-typecheck": {
          "purpose": "Code quality validation",
          "tools": ["flake8", "mypy", "black"],
          "blocking_failures": ["syntax errors"],
          "non_blocking": ["style warnings", "type hints"],
          "artifacts": ["lint_results.txt"]
        },
        "unit-tests": {
          "purpose": "Unit and integration test execution",
          "framework": "pytest",
          "coverage_target": "80%",
          "parallel_execution": true,
          "mock_environment": "keys.env with test values",
          "artifacts": ["coverage.xml", "htmlcov/", "test-results.xml"],
          "continue_on_error": true
        },
        "playwright-ui-tests": {
          "purpose": "End-to-end UI validation",
          "browser": "Chromium (headless)",
          "test_script": "playwright_chromium_setup.py",
          "tabs_tested": 10,
          "smoke_tests": ["Market Trends", "Signal Dashboard", "Portfolio"],
          "artifacts": ["ui_validation_report.json", "screenshots/"],
          "health_check": {
            "retries": 30,
            "delay_seconds": 2,
            "endpoint": "http://localhost:8050/"
          }
        },
        "docker-build-validation": {
          "purpose": "Multi-stage Docker build and validation",
          "stages": ["validation", "production"],
          "validation_checks": ["syntax", "imports", "pytest", "environment"],
          "artifacts": ["unified-dashboard-image.tar.gz"],
          "image_registry": "GitHub Actions artifacts (for CD reuse)"
        },
        "generate-reports": {
          "purpose": "CI summary report generation",
          "outputs": ["ci_summary_report.json", "GitHub Actions summary"],
          "includes": ["job statuses", "test results", "coverage", "Azure credential warnings"]
        }
      },
      "execution_time_estimate": "8-12 minutes",
      "success_criteria": {
        "required": ["lint-and-typecheck passes", "docker-build-validation succeeds"],
        "optional": ["unit-tests > 80% pass", "playwright-ui-tests > 70% pass"]
      }
    },
    "continuous_deployment": {
      "file": ".github/workflows/cd.yml",
      "trigger": ["workflow_dispatch", "ci.yml completion (on main branch)"],
      "deployment_modes": {
        "real_deployment": {
          "condition": "AZURE_CREDENTIALS secret exists",
          "azure_services": ["Azure Container Registry", "Azure App Service"],
          "deployment_slots": ["staging", "production"]
        },
        "mock_deployment": {
          "condition": "AZURE_CREDENTIALS secret missing",
          "behavior": "Log deployment steps without executing Azure operations",
          "purpose": "Validate pipeline logic before credentials available"
        }
      },
      "jobs": {
        "check-prerequisites": {
          "purpose": "Validate Azure credentials and configuration",
          "checks": ["AZURE_CREDENTIALS secret", "ACR_NAME", "AZURE_WEBAPP_NAME"],
          "outputs": {
            "azure_ready": "boolean (true if all secrets present)",
            "deployment_mode": "string ('real' or 'mock')"
          }
        },
        "build-and-push-acr": {
          "purpose": "Tag and push Docker image to Azure Container Registry",
          "conditional": "azure_ready == true",
          "mock_behavior": "Log ACR push command without executing",
          "image_source": "Download from CI artifacts (unified-dashboard-image.tar.gz)",
          "tag_format": "unified-dashboard:${GITHUB_SHA}-${GITHUB_RUN_NUMBER}"
        },
        "deploy-to-staging": {
          "purpose": "Deploy to Azure App Service staging slot",
          "conditional": "azure_ready == true",
          "action": "azure/webapps-deploy@v2",
          "app_settings": {
            "WEBSITE_PORT": "8050",
            "AZURE_ML_USE_MOCK": "false",
            "ENABLE_MARKET_LOOKUP": "1"
          },
          "health_check": {
            "retries": 10,
            "delay_seconds": 10,
            "endpoint": "${STAGING_URL}/"
          }
        },
        "smoke-tests": {
          "purpose": "Run Playwright smoke tests on staging deployment",
          "conditional": "deploy-to-staging succeeded AND azure_ready == true",
          "test_script": "playwright_chromium_setup.py --smoke-tests-only",
          "failure_handling": "Automatic rollback if smoke tests fail"
        },
        "deploy-to-production": {
          "purpose": "Blue-green deployment to production slot",
          "trigger": "Manual (workflow_dispatch with production environment)",
          "conditional": "azure_ready == true",
          "strategy": "Slot swap (staging → production)",
          "health_check": {
            "retries": 10,
            "delay_seconds": 10,
            "endpoint": "${PRODUCTION_URL}/"
          }
        },
        "rollback": {
          "purpose": "Automatic rollback on production deployment failure",
          "trigger": "deploy-to-production failed",
          "action": "Swap slots back (production → staging)",
          "notification": "GitHub Actions summary and email alert"
        },
        "generate-deployment-report": {
          "purpose": "Generate deployment metadata and logs",
          "outputs": ["deployment_report.json"],
          "retention": "90 days",
          "includes": ["timestamps", "Git SHA", "job statuses", "webapp URL", "ACR image reference"]
        }
      },
      "execution_time_estimate": {
        "mock_deployment": "2-3 minutes",
        "real_staging_deployment": "5-8 minutes",
        "real_production_deployment": "8-12 minutes"
      }
    }
  },
  "azure_integration": {
    "services_used": [
      {
        "name": "Azure Container Registry (ACR)",
        "purpose": "Docker image storage and versioning",
        "required_secrets": ["ACR_NAME", "AZURE_CREDENTIALS"],
        "configuration": {
          "registry_url": "${ACR_NAME}.azurecr.io",
          "repository": "unified-dashboard",
          "tag_strategy": "Git SHA + build number"
        }
      },
      {
        "name": "Azure App Service",
        "purpose": "Web application hosting",
        "required_secrets": ["AZURE_WEBAPP_NAME", "AZURE_CREDENTIALS"],
        "configuration": {
          "runtime": "Python 3.10",
          "deployment_slots": ["staging", "production"],
          "app_settings": ["WEBSITE_PORT=8050", "AZURE_ML_USE_MOCK=false"]
        }
      },
      {
        "name": "Azure OpenAI",
        "purpose": "AI inference for market analysis",
        "required_secrets": ["AZURE_OPENAI_KEY", "AZURE_OPENAI_ENDPOINT"],
        "status": "MISSING - Application will run in mock mode"
      },
      {
        "name": "Azure Storage",
        "purpose": "Blob storage for data persistence",
        "required_secrets": ["AZURE_STORAGE_KEY", "AZURE_STORAGE_ACCOUNT"],
        "status": "MISSING - Application will use local file storage"
      },
      {
        "name": "Azure Application Insights",
        "purpose": "Application monitoring and telemetry",
        "required_secrets": ["AZURE_APPINSIGHTS_KEY"],
        "status": "MISSING - No telemetry collection"
      }
    ],
    "authentication": {
      "method": "Service Principal",
      "required_credentials": {
        "AZURE_CLIENT_ID": "Present in keys.env",
        "AZURE_CLIENT_SECRET": "Present in keys.env",
        "AZURE_TENANT_ID": "Present in keys.env",
        "AZURE_SUBSCRIPTION_ID": "Present in keys.env"
      },
      "github_secret_format": {
        "name": "AZURE_CREDENTIALS",
        "structure": {
          "clientId": "${AZURE_CLIENT_ID}",
          "clientSecret": "${AZURE_CLIENT_SECRET}",
          "tenantId": "${AZURE_TENANT_ID}",
          "subscriptionId": "${AZURE_SUBSCRIPTION_ID}"
        },
        "instructions": "Create in GitHub repo: Settings → Secrets and variables → Actions → New repository secret"
      }
    },
    "missing_credentials": {
      "critical": [
        "AZURE_OPENAI_KEY",
        "AZURE_OPENAI_ENDPOINT",
        "AZURE_STORAGE_KEY",
        "AZURE_STORAGE_ACCOUNT",
        "AZURE_WEBAPP_NAME",
        "AZURE_APPINSIGHTS_KEY"
      ],
      "impact": "Pipeline will run in mock mode until these are added",
      "remediation_steps": [
        "1. Create Azure resources (Azure Portal or az CLI)",
        "2. Add keys to keys.env file in repository root",
        "3. Create AZURE_CREDENTIALS GitHub secret with service principal JSON",
        "4. Add ACR_NAME and AZURE_WEBAPP_NAME as GitHub secrets",
        "5. Re-run CD workflow → real deployment will execute"
      ]
    }
  },
  "docker_configuration": {
    "dockerfile": "Dockerfile",
    "multi_stage_builds": {
      "base": {
        "purpose": "Common dependencies",
        "base_image": "python:3.10-slim",
        "installs": ["curl", "git", "build-essential", "requirements.txt"]
      },
      "validation": {
        "purpose": "CI/CD pre-deployment validation",
        "extends": "base",
        "additional_installs": ["pytest", "pytest-cov", "flake8", "mypy", "black"],
        "validation_checks": ["syntax check", "import check", "environment validation", "unit tests"],
        "usage": "docker build --target validation -t unified-dashboard:validation ."
      },
      "production": {
        "purpose": "Production-ready minimal image",
        "extends": "base",
        "features": ["entrypoint script", "health check", "volume mount for keys.env"],
        "port": 8050,
        "usage": "docker build --target production -t unified-dashboard:latest ."
      },
      "development": {
        "purpose": "Development environment with debugging tools",
        "extends": "production",
        "additional_installs": ["ipython", "jupyter", "pytest", "black"],
        "usage": "docker build --target development -t unified-dashboard:dev ."
      }
    },
    "runtime_configuration": {
      "volume_mount": "-v $(pwd)/keys.env:/app/config/keys.env",
      "environment_variables": ["-e AZURE_ML_USE_MOCK=true", "-e PORT=8050"],
      "port_mapping": "-p 8050:8050",
      "health_check": "curl -f http://localhost:8050/ || exit 1"
    }
  },
  "playwright_configuration": {
    "test_script": "playwright_chromium_setup.py",
    "browser": "Chromium (headless)",
    "dashboard_tabs": [
      "Market Trends",
      "Analysis Hub",
      "Strategy Lab",
      "Market Forecast",
      "Portfolio",
      "Research Lab",
      "Volatility Lab",
      "Options Lab",
      "Backtest Dashboard",
      "Signal Dashboard"
    ],
    "smoke_tests_subset": ["Market Trends", "Signal Dashboard", "Portfolio"],
    "cli_arguments": {
      "--url": "Dashboard URL (default: http://localhost:8050)",
      "--output": "Output directory for screenshots/reports (default: ci_reports/ui_validation)",
      "--headless": "Run in headless mode (default: true)",
      "--headed": "Run with visible browser",
      "--smoke-tests-only": "Run only smoke tests",
      "--ci-mode": "CI mode (headless + strict validation)"
    },
    "outputs": {
      "report": "ui_validation_report.json",
      "screenshots": "*.png (one per tab)",
      "exit_codes": {
        "0": "All tests passed",
        "1": "Some tests failed",
        "2": "Test suite crashed"
      }
    }
  },
  "future_integrations": {
    "lambdatest_cross_browser": {
      "status": "Stub created (lambdatest_integration.py)",
      "purpose": "Cross-browser validation (Chrome, Firefox, Safari, Edge)",
      "activation": "Add LAMBDATEST_USERNAME and LAMBDATEST_ACCESS_KEY to secrets",
      "documentation": "See lambdatest_integration.py header comments"
    },
    "webcrawler_post_deploy": {
      "status": "Stub created (webcrawler_audit.py)",
      "purpose": "Post-deployment audit (broken links, accessibility, performance)",
      "activation": "Uncomment in cd.yml after smoke-tests job",
      "documentation": "See webcrawler_audit.py header comments"
    }
  },
  "execution_guide": {
    "first_time_setup": [
      "1. Clone repository: git clone <repo-url>",
      "2. Install dependencies: pip install -r requirements.txt",
      "3. Install Playwright browsers: playwright install chromium",
      "4. Copy keys.env.example to keys.env and add API keys",
      "5. Run locally: python signal_dashboard.py",
      "6. Test Playwright: python playwright_chromium_setup.py --headed"
    ],
    "ci_workflow_execution": [
      "1. Push code to GitHub: git push origin main",
      "2. GitHub Actions auto-triggers CI workflow",
      "3. Monitor: GitHub → Actions → CI workflow run",
      "4. Download artifacts: lint results, coverage, test results, Docker image",
      "5. Review ci_summary_report.json for overall status"
    ],
    "cd_workflow_execution_mock_mode": [
      "1. Navigate to GitHub → Actions → CD workflow",
      "2. Click 'Run workflow' → Select branch → Run",
      "3. Observe mock deployment logs (no Azure operations executed)",
      "4. Review deployment_report.json artifact",
      "5. Note: AZURE_CREDENTIALS secret missing → mock mode active"
    ],
    "cd_workflow_execution_real_deployment": [
      "1. Add missing Azure keys to keys.env",
      "2. Create AZURE_CREDENTIALS GitHub secret (JSON with service principal)",
      "3. Add ACR_NAME and AZURE_WEBAPP_NAME GitHub secrets",
      "4. Navigate to GitHub → Actions → CD workflow",
      "5. Click 'Run workflow' → Select branch → Run",
      "6. Observe real deployment to Azure staging slot",
      "7. If smoke tests pass, manually trigger production deployment",
      "8. Monitor production deployment and health checks",
      "9. If failure, automatic rollback triggers"
    ],
    "local_docker_testing": [
      "1. Build validation image: docker build --target validation -t unified-dashboard:validation .",
      "2. Build production image: docker build --target production -t unified-dashboard:latest .",
      "3. Run with volume mount: docker run -v $(pwd)/keys.env:/app/config/keys.env -p 8050:8050 unified-dashboard:latest",
      "4. Test health check: curl http://localhost:8050/",
      "5. View logs: docker logs <container-id>"
    ]
  },
  "troubleshooting": {
    "ci_workflow_failures": {
      "lint_failures": "Run locally: flake8 . && black --check . && mypy .",
      "test_failures": "Run locally: pytest tests/ -v --tb=short",
      "playwright_failures": "Check dashboard startup: python signal_dashboard.py & sleep 5 && curl http://localhost:8050/",
      "docker_build_failures": "Check Dockerfile syntax and build logs"
    },
    "cd_workflow_issues": {
      "azure_credentials_missing": "Check GitHub repo secrets: Settings → Secrets → AZURE_CREDENTIALS",
      "acr_push_failures": "Verify ACR_NAME secret and Azure login succeeded",
      "deployment_failures": "Check Azure App Service logs and health check endpoint",
      "smoke_test_failures": "Review Playwright screenshots in artifacts"
    },
    "azure_integration_issues": {
      "openai_api_errors": "Verify AZURE_OPENAI_KEY and AZURE_OPENAI_ENDPOINT in keys.env",
      "storage_errors": "Verify AZURE_STORAGE_KEY and AZURE_STORAGE_ACCOUNT in keys.env",
      "webapp_not_starting": "Check Azure App Service logs: az webapp log tail --name <webapp-name> --resource-group <rg>"
    }
  }
}
